        SYNTAX          EsAclVlanSubMapEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry is defined esAclVlanSubMapTable.
            "
        INDEX {
            esAclVlanAccMapName,
            esAclVlanAccSubMapSeq
        }
        ::= { esAclVlanSubMapTable 1 }

    EsAclVlanSubMapEntry ::= SEQUENCE {
        esAclVlanAccMapName                  DisplayString,
        esAclVlanAccSubMapSeq                Integer32,
        esAclVlanAccSubMapRowStatus            RowStatus,
        esAclVlanAccSubMapMatchAclName       DisplayString,
        esAclVlanAccessSubMapAction          INTEGER,
        esAclVlanAccSubMapRedirectIfIndex    InterfaceIndexOrZero,
        esAclVlanAccSubMapMatchAclId       Integer32
    }

     esAclVlanAccMapName OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (1..32))
