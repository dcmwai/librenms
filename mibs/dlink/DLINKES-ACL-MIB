DLINKES-ACL-MIB DEFINITIONS ::= BEGIN


    IMPORTS
        MODULE-IDENTITY,
        OBJECT-TYPE,
        Integer32,
        Unsigned32,
        IpAddress,
        Counter64
            FROM SNMPv2-SMI
        MacAddress,
        DisplayString,
        TruthValue,
        RowStatus,
        TEXTUAL-CONVENTION
            FROM SNMPv2-TC
        MODULE-COMPLIANCE,
        OBJECT-GROUP
            FROM SNMPv2-CONF
        InterfaceIndex,
        InterfaceIndexOrZero
            FROM IF-MIB
        VlanId,VlanIdOrNone
            FROM Q-BRIDGE-MIB
        InetAddressIPv6,
        InetAddressPrefixLength
            FROM INET-ADDRESS-MIB
        dlinkCommon
            FROM DLINK-ID-REC-MIB;


    dlinkEsAclMIB MODULE-IDENTITY
        LAST-UPDATED "201511260000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "        D-Link Corporation
             Postal: No. 289, Sinhu 3rd Rd., Neihu District,
             Taipei City 114, Taiwan, R.O.C
             Tel:     +886-2-66000123
             E-mail: tsd@dlink.com.tw
            "
        DESCRIPTION
                "The Structure of Access Control List Information for the
                 proprietary enterprise."

        REVISION "201511260000Z"
        DESCRIPTION
            "Add DEFVAL for nodes esAclIpAccessRuleSrcPort,esAclIpAccessRuleQosPrecedence etc.
            And correct description of node esAclReSeqIncrement."

        REVISION "201507100000Z"
        DESCRIPTION
            "Add nodes to support vlan range, traffic class, l4 port mask operator, and mask for some nodes."

        REVISION "201311130000Z"
        DESCRIPTION
            "Add 'deny-cpu'option for DlinkAclRuleType."

        REVISION "201308200000Z"
        DESCRIPTION
            "Add nodes for counter function, access list remark, access list id, and some rule items."

        REVISION "201302080000Z"
        DESCRIPTION
            "This is the first version of the MIB file for 'ACL' functionality."
        ::= { dlinkCommon 28}

    DlinkAclRuleType ::= TEXTUAL-CONVENTION
        STATUS         current
        DESCRIPTION
             "The action type when the packets match the access profile.

             permit(1)- Specifies that packets that match the access rule are
                        permitted to be forwarded by the switch.
             deny(2)  - Specifies that packets that match the access rule
                        are not permitted to be forwarded by the switch and will be filtered.
             denyCpu(3)- Specifies that packet that match the access rule are prevented to be
                         copied to CPU and redirected to CPU. And the hardware forwarding behavior
                         should not be affected.
            "
        SYNTAX         INTEGER {
            permit(1),
            deny(2),
            denyCpu(3)
        }

    DlinkAclPortOperatorType ::= TEXTUAL-CONVENTION
        STATUS         current
        DESCRIPTION
            " The type of UDP/TCP port operator indicates how a packet's
             TCP/UDP source or destination port number is compared.
            none(1) - No comparison.
            eq (2)- equal
            gt (3)- greater than.
            lt (4)- less than.
            neq(5)- not equal
            range(6)- compares the port value between two numbers.
            mask(7)- check the bit corresponding to bit value 1, ignore the bit corresponding to bit value 0.
            "
        SYNTAX         INTEGER {
            none(1),
            eq(2),
            gt(3),
            lt(4),
            neq(5),
            range(6),
            mask(7)
        }

    TcpFlag ::= TEXTUAL-CONVENTION
        STATUS current
        DESCRIPTION
            "The TCP flag fields. Each bit defined as follow:
                urgent(0) - urgent.
                acknowledge(1) - acknowledge.
                push(2) - push,
                reset(3) - reset.
                synchronize(4) - synchronize.
            finish (5) - finish.
        "
    SYNTAX             BITS {
                urgent(0),
                acknowledge(1),
                push(2),
                reset(3),
                synchronize(4),
              finish (5)
      }

-- -----------------------------------------------------------------------------
    esAclMIBNotifications    OBJECT IDENTIFIER ::= { dlinkEsAclMIB 0 }
    esAclMIBObjects          OBJECT IDENTIFIER ::= { dlinkEsAclMIB 1 }
    esAclMIBConformance      OBJECT IDENTIFIER ::= { dlinkEsAclMIB 2 }

-- -----------------------------------------------------------------------------
    esAclGeneral          OBJECT IDENTIFIER ::= { esAclMIBObjects 1 }

    esAclReSeqTable    OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsAclReSeqEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table consists of a list of information about how re-sequencing
            the rules in access lists.
            "
        ::= { esAclGeneral 1 }

    esAclReSeqEntry OBJECT-TYPE
        SYNTAX          EsAclReSeqEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry appears in this table for controlling the re-sequence of
            an access-list."
        INDEX  { esAclReSeqAccessListName }
        ::= { esAclReSeqTable 1 }

    EsAclReSeqEntry ::= SEQUENCE {
        esAclReSeqAccessListName             DisplayString,
        esAclReSeqStartingNumber             Integer32,
        esAclReSeqIncrement                  Integer32
    }
    esAclReSeqAccessListName OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (1..32))
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Indicates the name of an access list."
        ::= { esAclReSeqEntry 1 }

    esAclReSeqStartingNumber OBJECT-TYPE
        SYNTAX          Integer32 ( 1..65535 )
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "Indicates the initial value of sequence number of the corresponding
            access list."
        DEFVAL { 10 }
        ::= { esAclReSeqEntry 2 }

    esAclReSeqIncrement OBJECT-TYPE
        SYNTAX          Integer32 ( 1..32 )
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "Indicates the number that the sequence numbers step.
            If the increment value is 5 and the beginning sequence number is 20,
            the subsequent sequence numbers are 25, 30, 35, 40, and so on."
        DEFVAL { 10 }
        ::= { esAclReSeqEntry 3 }

-- -----------------------------------------------------------------------------
    esAclMac              OBJECT IDENTIFIER ::= { esAclMIBObjects 2 }
    esAclMacAccessListNumber  OBJECT-TYPE
        SYNTAX          Unsigned32
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "Indicates the number of entries present in the MAC access list
             table."
        ::= { esAclMac 1 }

    esAclMacAccessListTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsAclMacAccessListEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The table contains information about MAC access list."
        ::= { esAclMac 2 }

    esAclMacAccessListEntry OBJECT-TYPE
        SYNTAX          EsAclMacAccessListEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry defined in esAclMacAccessListTable. An entry is
            created/removed when an MAC access list is created/deleted."
        INDEX { esAclMacAccessListName }
        ::= { esAclMacAccessListTable 1 }

    EsAclMacAccessListEntry ::= SEQUENCE {
        esAclMacAccessListName           DisplayString,
        esAclMacAccessListRowStatus      RowStatus,
        esAclMacAccessListId                Integer32,
        esAclMacAccessListCounterEnabled        TruthValue,
        esAclMacAccessListClearStatAction  INTEGER,
        esAclMacAccessListRemark        DisplayString
    }

    esAclMacAccessListName OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (1..32))
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The name of the MAC access list."
        ::= { esAclMacAccessListEntry 1 }

    esAclMacAccessListRowStatus OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This object allows the dynamic creation and deletion of a MAC
            access list."
        ::= { esAclMacAccessListEntry 2 }

    esAclMacAccessListId OBJECT-TYPE
        SYNTAX          Integer32
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The number of the MAC access list.
            If user specify value zero(0) for this node, agent will assign a number
                for it. After the table created, this node should not be changed."
        ::= { esAclMacAccessListEntry 3 }

     esAclMacAccessListCounterEnabled    OBJECT-TYPE
        SYNTAX              TruthValue
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
             "This object indicates the counter state of the access list is
             enabled('true') or disabled('false'). And the counter state just
             for the all interface that applied the access list in
             esAclMacAccessGroupTable.
             "
        ::= { esAclMacAccessListEntry 4 }

     esAclMacAccessListClearStatAction      OBJECT-TYPE
        SYNTAX              INTEGER{
                            clear(1),
                            noOp(2)
            }
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
            "This object is used to clear statistics of the access list when set
            to 'clear'. No action is taken if this object is set to 'noOp'.
            The 'clear' action just for the all interface that applied the access
            list in esAclMacAccessGroupTable.
            When read, the value 'noOp' is returned."
        ::= { esAclMacAccessListEntry 5 }

     esAclMacAccessListRemark OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (0..255))
        MAX-ACCESS       read-create
        STATUS          current
        DESCRIPTION
            "The description of the MAC access list."
        ::= { esAclMacAccessListEntry 6 }

-- -----------------------------------------------------------------------------
    esAclMacAccessRuleTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsAclMacAccessRuleEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table consists of a list of rules for the MAC access list."
        ::= { esAclMac 3 }

    esAclMacAccessRuleEntry OBJECT-TYPE
        SYNTAX          EsAclMacAccessRuleEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry is defined esAclMacAccessRuleTable.
            The first instance identifier index value identifies the
            esAclMacAccessListEntry that a MAC access rule (esAclMacAccessRuleEntry)
            belongs to. An entry is removed from this table when its
            corresponding esAclMacAccessListEntry is deleted."
        INDEX {
            esAclMacAccessListName,
            esAclMacAccessRuleSn
        }
        ::= { esAclMacAccessRuleTable 1 }

    EsAclMacAccessRuleEntry ::= SEQUENCE {
        esAclMacAccessRuleSn                 Integer32,
        esAclMacAccessRuleRowStatus          RowStatus,
        esAclMacAccessRuleAction             DlinkAclRuleType,
        esAclMacAccessRuleSrcMacAddr         MacAddress,
        esAclMacAccessRuleSrcMacWildcard     MacAddress,
        esAclMacAccessRuleDstMacAddr         MacAddress,
        esAclMacAccessRuleDstMacWildcard     MacAddress,
        esAclMacAccessRulePacketType         INTEGER,
        esAclMacAccessRuleEthernetType       Integer32,
        esAclMacAccessRuleDot1p              Integer32,
        esAclMacAccessRuleInnerDot1p         Integer32,
        esAclMacAccessRuleVlanID             VlanIdOrNone,
        esAclMacAccessRuleInnerVlanID        VlanIdOrNone,
        esAclMacAccessRuleTimeName           DisplayString,
        esAclMacAccessRuleEthernetTypeMask   OCTET STRING,
        esAclMacAccessRuleDot1pMask          OCTET STRING,
        esAclMacAccessRuleInnerDot1pMask     OCTET STRING,
        esAclMacAccessRuleVlanIDMask         OCTET STRING,
        esAclMacAccessRuleInnerVlanIDMask    OCTET STRING
        }

    esAclMacAccessRuleSn  OBJECT-TYPE
        SYNTAX          Integer32 (0..65535)
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Specifies the sequence number of this rule.
            The lower the number is, the higher the priority of the rule.
            The special value of 0 means the sequence number will be automatically
            determined by the agent."
        ::= { esAclMacAccessRuleEntry 1 }

    esAclMacAccessRuleRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The row status variable, used according to installation
             and removal conventions for conceptual rows."
        ::= { esAclMacAccessRuleEntry 2 }

    esAclMacAccessRuleAction OBJECT-TYPE
        SYNTAX          DlinkAclRuleType
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the result of the packet examination is to
             permit or deny or prevent to CPU.
            "
        ::= { esAclMacAccessRuleEntry 3 }

    esAclMacAccessRuleSrcMacAddr OBJECT-TYPE
        SYNTAX          MacAddress
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies a source MAC address."
        ::= { esAclMacAccessRuleEntry 4 }

    esAclMacAccessRuleSrcMacWildcard OBJECT-TYPE
        SYNTAX          MacAddress
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object is a wildcard bitmap to specify a group of source
            MAC addresses. The bit value 1 indicates the corresponding bit will
            be ignored. The bit value 0 indicates the corresponding bit will be
            checked. In other words, when the value of all 'ff'Hs indicates any
            source MAC address is specified. When the value of all '00'Hs indicates
            host source MAC address is specified."
        ::= { esAclMacAccessRuleEntry 5 }

    esAclMacAccessRuleDstMacAddr  OBJECT-TYPE
        SYNTAX          MacAddress
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies a destination MAC address."
        ::= { esAclMacAccessRuleEntry 6 }

    esAclMacAccessRuleDstMacWildcard  OBJECT-TYPE
        SYNTAX          MacAddress
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object is a wildcard bitmap to specify a group of destination
            MAC addresses. The bit value 1 indicates the corresponding bit will
            be ignored. The bit value 0 indicates the corresponding bit will be
            checked. In other words, when the value of all 'ff'Hs indicates any
            destination MAC address is specified. When the value of all '00'Hs
            indicates host destination MAC address is specified."
        ::= { esAclMacAccessRuleEntry 7 }

    esAclMacAccessRulePacketType  OBJECT-TYPE
        SYNTAX          INTEGER {
            none(1),
            ethernet(2),
            llc(3)
        }
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the Ethernet frame type. The value of none (1) means the
            frame type is not specified."
        DEFVAL { none }
        ::= { esAclMacAccessRuleEntry 8 }

    esAclMacAccessRuleEthernetType  OBJECT-TYPE
        SYNTAX      Integer32 (-1 | 0..65535)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the Ethernet type for an Ethernet II or SNAP packet.
             The special value of -1 means the Ethernet type value is not specified.
             It is only meaningful when the esAclMacAccessRulePacketType is
              'ethernet'."
        DEFVAL { -1 }
        ::= { esAclMacAccessRuleEntry 9}

    esAclMacAccessRuleDot1p  OBJECT-TYPE
        SYNTAX      Integer32 (-1 | 0..7)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the priority value. The value of -1 means the priority
             is not specified."
        DEFVAL { -1 }
        ::= { esAclMacAccessRuleEntry 10 }

     esAclMacAccessRuleInnerDot1p  OBJECT-TYPE
        SYNTAX      Integer32 (-1 | 0..7)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the inner priority value. The value of -1 means the
            inner priority is not specified."
        DEFVAL { -1 }
        ::= { esAclMacAccessRuleEntry 11 }

    esAclMacAccessRuleVlanID  OBJECT-TYPE
        SYNTAX          VlanIdOrNone
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the VLAN ID.
             A value of zero indicates the VLAN ID is not specified.
             This node and esAclMacAccessRuleVlanRangeMin/esAclMacAccessRuleVlanRangeMax
             cannot be specified at same time in a row."
        DEFVAL { 0 }
        ::= { esAclMacAccessRuleEntry 12 }

    esAclMacAccessRuleInnerVlanID  OBJECT-TYPE
        SYNTAX          VlanIdOrNone
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the inner VLAN ID. A value of zero indicates
            the inner VLAN ID is not specified."
        DEFVAL { 0 }
        ::= { esAclMacAccessRuleEntry 13 }

    esAclMacAccessRuleTimeName  OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the name of time-period profile associated with
            the access-list delineating its activation period.
            The value 'NULL' means that this rule is not bound with any Time
            mechanism."
        ::= { esAclMacAccessRuleEntry 14 }

     esAclMacAccessRuleEthernetTypeMask  OBJECT-TYPE
        SYNTAX      OCTET STRING(SIZE(2))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the mask for ethernet type defined by esAclMacAccessRuleEthernetType.
             Valid values are from 0x0000 to 0xFFFF.
             Default value is 0xFFFF.
             This node is valid only for the esAclMacAccessRuleEthernetType specified."
         ::= { esAclMacAccessRuleEntry 15}

     esAclMacAccessRuleDot1pMask  OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(1))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the mask for priority defined by esAclMacAccessRuleDot1p.
             Valid values are from 0x00 to 0x07.
             Default value is 0x07.
             This node is valid only for the esAclMacAccessRuleDot1p specified."
         ::= { esAclMacAccessRuleEntry 16 }

     esAclMacAccessRuleInnerDot1pMask  OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(1))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the mask for inner priority defined by esAclMacAccessRuleInnerDot1p.
             Valid values are from 0x00 to 0x07.
             Default value is 0x07.
             This node is valid only for the esAclMacAccessRuleInnerDot1p specified."
        ::= { esAclMacAccessRuleEntry 17 }

     esAclMacAccessRuleVlanIDMask  OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(2))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the mask for VLAN ID defined by esAclMacAccessRuleVlanID.
             Valid values are from 0x0000 to 0x0FFF.
             This node and esAclMacAccessRuleVlanRangeMin/esAclMacAccessRuleVlanRangeMax
             cannot be specified at same time in a row.
             Default value is 0x0FFF.
             This node is valid only for the esAclMacAccessRuleVlanID specified."
        ::= { esAclMacAccessRuleEntry 18 }

     esAclMacAccessRuleInnerVlanIDMask  OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(2))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the mask for inner VLAN ID defined by esAclMacAccessRuleInnerVlanID.
             Valid values are from 0x0000 to 0x0FFF.
             Default value is 0x0FFF.
             This node is valid only for the esAclMacAccessRuleInnerVlanID specified."
        ::= { esAclMacAccessRuleEntry 19 }


-- -----------------------------------------------------------------------------
    esAclMacAccessGroupTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsAclMacAccessGroupEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The table represents a list of MAC access group configuration."
        ::= { esAclMac 4 }

    esAclMacAccessGroupEntry OBJECT-TYPE
        SYNTAX          EsAclMacAccessGroupEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "An entry in esAclMacAccessGroupTable contains interface specific
            MAC access list association."
        INDEX { esAclMacAccessGroupIfIndex, esAclMacAccessGroupApplyDirection }
        ::= { esAclMacAccessGroupTable 1 }

    EsAclMacAccessGroupEntry ::= SEQUENCE {
        esAclMacAccessGroupIfIndex    InterfaceIndex,
        esAclMacAccessGroupApplyDirection     INTEGER,
        esAclMacAccessGroupRowStatus  RowStatus,
        esAclMacAccessGroupAclName  DisplayString,
        esAclMacAccessGroupAclId        Integer32
    }

    esAclMacAccessGroupIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Indicates the ifIndex of the interface.
            Only physical port is valid interface."
        ::= { esAclMacAccessGroupEntry 1 }

    esAclMacAccessGroupApplyDirection OBJECT-TYPE
        SYNTAX          INTEGER{
            inbound(1),
            outbound(2)
           }
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
               "Indicates whether this access list is to be attached to ingress
               or egress direction."
        ::= { esAclMacAccessGroupEntry 2 }

    esAclMacAccessGroupRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The row status variable, used according to installation
            and removal conventions for conceptual rows."
        ::= { esAclMacAccessGroupEntry 3 }

    esAclMacAccessGroupAclName OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (1..32))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The name of the MAC access list to be applied.
            "
        ::= { esAclMacAccessGroupEntry 4 }

    esAclMacAccessGroupAclId OBJECT-TYPE
        SYNTAX          Integer32
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The ID of the MAC access list to be applied.
               User maybe specify access list ID(by this object) or name (by
               esAclMacAccessGroupAclName) to be applied. If both access list
               ID and name are specified, the access list name specified by
               esAclMacAccessGroupAclName will be take.
            "
        ::= { esAclMacAccessGroupEntry 5 }
-- -----------------------------------------------------------------------------
    esAclIp               OBJECT IDENTIFIER ::= { esAclMIBObjects 3 }
    esAclIpAccessListNumber  OBJECT-TYPE
        SYNTAX          Unsigned32
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "Indicates the number of entries present in the IP access list
            table."
        ::= { esAclIp 1 }

    esAclIpAccessListTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsAclIpAccessListEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The table contains IP access list configuration."
        ::= { esAclIp 2 }

    esAclIpAccessListEntry OBJECT-TYPE
        SYNTAX          EsAclIpAccessListEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry defined in esAclIpAccessListTable. An entry is
            created/removed when an IP access list is created/deleted."
        INDEX { esAclIpAccessListName }
        ::= { esAclIpAccessListTable 1 }

    EsAclIpAccessListEntry ::= SEQUENCE {
        esAclIpAccessListName        DisplayString,
        esAclIpAccessListRowStatus   RowStatus,
        esAclIpAccessExtended        TruthValue,
        esAclIpAccessListId            Integer32,
        esAclIpAccessListCounterEnabled    TruthValue,
        esAclIpAccessListClearStatAction     INTEGER,
        esAclIpAccessListRemark        DisplayString
    }

    esAclIpAccessListName OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (1..32))
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The name of the IP access list."
        ::= { esAclIpAccessListEntry 1 }

    esAclIpAccessListRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object allows the dynamic creation and
             deletion of an IP access list."
        ::= { esAclIpAccessListEntry 2 }

    esAclIpAccessExtended OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the IP access list is extended ('true') or
            standard ('false').
            A standard ip access list means only IP address related i.e.
            source or destination IP address is specified for the filter.
            For an extended IP access list, more fields can be chosen for the
            filter."
        ::= { esAclIpAccessListEntry 3 }

    esAclIpAccessListId OBJECT-TYPE
        SYNTAX          Integer32
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The number of the IP access list.
            If user specify value zero(0) for this node, agent will assign a number
                for it. After the table created, this node should not be changed."
        ::= { esAclIpAccessListEntry 4 }

     esAclIpAccessListCounterEnabled    OBJECT-TYPE
        SYNTAX  TruthValue
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
             "This object indicates the counter state of the access list is
              enabled('true') or disabled('false'). And the counter just for
              the all interface that applied the access list in
              esAclIpAccessGroupTable."
        ::= { esAclIpAccessListEntry 5 }

      esAclIpAccessListClearStatAction      OBJECT-TYPE
        SYNTAX              INTEGER{
                            clear(1),
                            noOp(2)
            }
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
            "This object is used to clear statistics of the access list when set
            to 'clear'. No action is taken if this object is set to 'noOp'.
            The 'clear' action just for the all interface that applied the access
            list in esAclIpAccessGroupTable.
            When read, the value 'noOp' is returned."
        ::= { esAclIpAccessListEntry 6 }

     esAclIpAccessListRemark OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (0..255))
        MAX-ACCESS       read-create
        STATUS          current
        DESCRIPTION
            "The description of the IP access list."
        ::= { esAclIpAccessListEntry 7 }

-- -----------------------------------------------------------------------------
    esAclIpAccessRuleTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsAclIpAccessRuleEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The table contains a list of IP access rules for IP access lists."
        ::= { esAclIp 3}

    esAclIpAccessRuleEntry OBJECT-TYPE
        SYNTAX          EsAclIpAccessRuleEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry is defined esAclIpAccessRuleTable.
            The first instance identifier index value identifies the
            esAclIpAccessListEntry that an IP access rule (esAclIpAccessRuleEntry)
            belongs to. An entry is removed from this table when its
            corresponding esAclIpAccessRuleEntry is deleted."
        INDEX {
            esAclIpAccessListName,
            esAclIpAccessRuleSn
        }
        ::= { esAclIpAccessRuleTable 1 }

    EsAclIpAccessRuleEntry ::= SEQUENCE {
