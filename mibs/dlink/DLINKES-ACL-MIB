            pcp(6),
            sctp(7)
        }
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the IP protocol."
        ::= { esAclIPv6AccessRuleEntry 4 }

    esAclIPv6AccessRuleUserDefProtocol OBJECT-TYPE
        SYNTAX          Integer32 (-1 | 0..255)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the user defined protocol ID when the
            esAclIPv6AccessRuleProtocol is 'userDefine (1)'.
            The value of -1 means the user defined protocol ID is not
            specified."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 5 }

    esAclIPv6AccessRuleSrcAddr OBJECT-TYPE
        SYNTAX          InetAddressIPv6
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies a source IPv6 address."
        ::= { esAclIPv6AccessRuleEntry 6 }

    esAclIPv6AccessRuleSrcPrefixLen OBJECT-TYPE
        SYNTAX          InetAddressPrefixLength
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the length in bits of source IPv6 address will be
            matched. In other words, the value of 0 indicates any source
            IPv6 address is specified. When the value of 128 indicates
            host IPv6 source address is specified."
        ::= { esAclIPv6AccessRuleEntry 7 }

    esAclIPv6AccessRuleDstAddr OBJECT-TYPE
        SYNTAX          InetAddressIPv6
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies a destination IPv6 address."
        ::= { esAclIPv6AccessRuleEntry 8 }

    esAclIPv6AccessRuleDstPrefixLen OBJECT-TYPE
        SYNTAX          InetAddressPrefixLength
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
           "Specifies the length in bits of destination IPv6 address will be
            matched. In other words, the value of 0 indicates any destination
            IPv6 address is specified. When the value of 128 indicates
            host IPv6 destination address is specified."
        ::= { esAclIPv6AccessRuleEntry 9 }

     esAclIPv6AccessRuleSrcOperator OBJECT-TYPE
        SYNTAX          DlinkAclPortOperatorType
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates how a packet's TCP/UDP source port number is
            compared.
            When the value of this object is eq(2),gt(3),lt(4) or neq(5) uses
            the esAclIPv6AccessRuleSrcPort as an operand which is the only one needed.

            When the value of this object is range(6) needs 2 operands. One is
            esAclIPv6AccessRuleSrcPort, which is the starting port number of the
            range, and the other operand is esAclIPv6AccessRuleSrcPortRange,
            which is the ending port number of the range.

            When the value of this object is mask(7) needs 2 operands. One is
            esAclIPv6AccessRuleSrcPort, the other operand is esAclIPv6AccessRuleSrcPortMask.

            This object is used for TCP/UDP protocol only, hence when the object
            'esAclIPv6AccessRuleProtocol' is set to other than TCP/UDP, the object has
            to be 'none(1)'."
        ::= { esAclIPv6AccessRuleEntry 10 }

    esAclIPv6AccessRuleSrcPort OBJECT-TYPE
        SYNTAX          Integer32 (-1..65535)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the source port number of TCP/UDP protocol.
            If the value is -1, it means the value is not specified.
            If the esAclIPv6AccessRuleSrcOperator object in the same row is
            range(6), this object will be the starting port number of the port
            range.
            This object only can be configured esAclIPv6AccessRuleSrcOperator in
            the same row is not 'none(1)'."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 11 }

    esAclIPv6AccessRuleSrcPortRange OBJECT-TYPE
        SYNTAX          Integer32 (-1..65535)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The source port number of the TCP/UDP protocol. If the
            esAclIPv6AccessRuleSrcOperator object in the same row is range(6), this
            object will be the ending port number of the port range.
           The value of -1 means the ending port number is not specified."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 12 }

    esAclIPv6AccessRuleDstOperator OBJECT-TYPE
        SYNTAX          DlinkAclPortOperatorType
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates how a packet's TCP/UDP destination port number is
            compared.
            When the value of this object is eq(2),gt(3),lt(4) or neq(5) uses
            the esAclIPv6AccessRuleDstPort as an operand which is the only one needed.

            When the value of this object is range(6) needs 2 operands. One is
            esAclIPv6AccessRuleDstPort, which is the starting port number of the
            range, and the other operand is esAclIPv6AccessRuleDstPortRange,
            which is the ending port number of the range.

            When the value of this object is mask(7) needs 2 operands. One is
            esAclIPv6AccessRuleDstPort, the other operand is esAclIPv6AccessRuleDstPortMask.

            This object is used for TCP/UDP protocol only, hence when the object
            'esAclIPv6AccessRuleProtocol' is set to other than TCP/UDP, the object has
            to be 'none(1)'."
        ::= { esAclIPv6AccessRuleEntry 13 }

     esAclIPv6AccessRuleDstPort OBJECT-TYPE
        SYNTAX      Integer32 (-1..65535)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This object indicates the destination port number of TCP/UDP protocol.
            If the value is -1, it means the value is not specified.
            If the esAclIPv6AccessRuleDstOperator object in the same row is
            range(6), this object will be the starting port number of the port
            range.
            This object only can be configured esAclIPv6AccessRuleDstOperator in
            the same row is not 'none(1)'."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 14 }

    esAclIPv6AccessRuleDstPortRange OBJECT-TYPE
        SYNTAX          Integer32 (-1..65535)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The destination port number of the TCP/UDP protocol. If the
            esAclIPv6AccessRuleDstOperator object in the same row is range(6), this
            object will be the ending port number of the port range.
            The value of -1 means the ending port number is not specified."
        ::= { esAclIPv6AccessRuleEntry 15 }

    esAclIPv6AccessRuleDscp OBJECT-TYPE
        SYNTAX       Integer32 (-1 | 0 .. 63)
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "Specifies the matching DSCP code value in IPv6 header.
            The value of -1 means the DSCP value is not specified."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 16 }

     esAclIPv6AccessRuleIcmpType OBJECT-TYPE
        SYNTAX      Integer32 (-1 | 0..255)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This object indicates the type of ICMP protocol.
            The value of -1 means the ICMP type is not specified.
            This object is used for ICMP protocol only, hence when the object
            'esAclIPv6AccessRuleProtocol' is set to other than ICMP, the object has
            to be -1."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 17 }

    esAclIPv6AccessRuleIcmpCode OBJECT-TYPE
        SYNTAX      Integer32 (-1 | 0..255)
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "This object indicates the code of ICMP protocol.
            If the value is -1, it means the value is not specified.
            This object is used for ICMP protocol only, hence when the object
            'esAclIPv6AccessRuleProtocol' is set to other than ICMP, the object has
            to be -1."
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 18 }

    esAclIPv6AccessRuleTimeName  OBJECT-TYPE
        SYNTAX      DisplayString
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION
            "Specifies the name of time-period profile associated with the
            access-list delineating its activation period.
            The value 'NULL' means that this rule is not bound with any Time
            mechanism."
        ::= { esAclIPv6AccessRuleEntry 19 }

    esAclIPv6AccRuleTcpFlag  OBJECT-TYPE
        SYNTAX        TcpFlag
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "Specifies the TCP flag fields. And this node is available only for TCP protocol.
                The default value for this node is empty set, which means no TCP flag values are set.
                 "
        ::= { esAclIPv6AccessRuleEntry 20 }

    esAclIPv6AccRuleFragments  OBJECT-TYPE
        SYNTAX       TruthValue
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "This object indicates the Packet fragment filtering status
            is  enabled('true') or disabled('false')."
        ::= { esAclIPv6AccessRuleEntry 21 }

    esAclIPv6AccRuleFlowLabel  OBJECT-TYPE
        SYNTAX       Integer32 (-1 | 0..1048575)
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "This object indicates the Flow label value.
            The value of -1 means the flow-label value is not specified.
        "
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 22 }

     esAclIPv6AccRuleTrafficClass OBJECT-TYPE
        SYNTAX       Integer32 (-1 | 0 .. 255)
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "Specifies the matching traffic class value in IPv6 header.
            The value of -1 means the traffic class value is not specified.
            This node and esAclIPv6AccessRuleDscp cannot be specified at same time in a row.
            "
        DEFVAL { -1 }
        ::= { esAclIPv6AccessRuleEntry 23 }

     esAclIPv6AccRuleUserDefProtocolMask OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(1))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the mask for protocol ID defined by esAclIPv6AccessRuleUserDefProtocol.
             Valid values are from 0x00 to 0xFF.
             Default value is 0xFF.
             This node is valid only for the esAclIPv6AccessRuleUserDefProtocol specified."
        ::= { esAclIPv6AccessRuleEntry 24 }

     esAclIPv6AccRuleSrcPortMask OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(2))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the mask for L4 source port defined by esAclIPv6AccessRuleSrcPort.
             Valid values are from 0x0 to 0xFFFF.
             Default value is 0xFFFF.
             This object only can be configured esAclIPv6AccessRuleSrcOperator in the
             same row is 'mask(7)'.
             This node is valid only for the esAclIPv6AccessRuleSrcPort specified."
        ::= { esAclIPv6AccessRuleEntry 25 }

     esAclIPv6AccRuleDstPortMask OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(2))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "Specifies the mask for L4 destination port defined by esAclIPv6AccessRuleDstPort.
             Valid values are from 0x0 to 0xFFFF.
             Default value is 0xFFFF.
             This object only can be configured esAclIPv6AccessRuleDstOperator in the
             same row is 'mask(7)'.
             This node is valid only for the esAclIPv6AccessRuleDstPort specified."
        ::= { esAclIPv6AccessRuleEntry 26 }

     esAclIPv6AccRuleDscpMask OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(1))
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "Specifies the mask for DSCP code defined by esAclIPv6AccessRuleDscp.
             Valid values are from 0x0 to 0x3F.
             Default value is 0x3F.
             This node is valid only for the esAclIPv6AccessRuleDscp specified."
        ::= { esAclIPv6AccessRuleEntry 27 }

     esAclIPv6AccRuleFlowLabelMask  OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(3))
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "Specifies the mask for Flow label value defined by esAclIPv6AccRuleFlowLabel.
             Valid values are from 0x0 to 0xFFFFF.
             Default value is 0xFFFFF.
             This node is valid only for the esAclIPv6AccRuleFlowLabel specified."
       ::= { esAclIPv6AccessRuleEntry 28 }

     esAclIPv6AccRuleTrafficClassMask  OBJECT-TYPE
        SYNTAX OCTET STRING(SIZE(1))
        MAX-ACCESS   read-create
        STATUS       current
        DESCRIPTION
            "Specifies the mask for traffic class defined by esAclIPv6AccRuleTrafficClass.
             Valid values are from 0x0 to 0xFF.
             Default value is 0xFF.
             This node is valid only for the esAclIPv6AccRuleTrafficClass specified."
        ::= { esAclIPv6AccessRuleEntry 29 }

