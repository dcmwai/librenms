	esCpuProtectSubIntfRLCntTotalCnt OBJECT-TYPE
		SYNTAX      Counter64
		MAX-ACCESS  read-only
		STATUS      current
		DESCRIPTION
			"This object indicates the counter which counts the packets
			 received by CPU (per unit/slot) for the subinterface."
		::= { esCpuProtectSubIntfRLCounterEntry 3 }

	esCpuProtectSubIntfRLCntDropCnt OBJECT-TYPE
		SYNTAX      Counter64
		MAX-ACCESS  read-only
		STATUS      current
		DESCRIPTION
			"This object indicates the counter which counts the dropped
			packets due to exceeding the configured rate-limit."
		::= { esCpuProtectSubIntfRLCounterEntry 4 }

--  ***************************************************************************
--  Conformance
--  ***************************************************************************

    esCpuProtectMIBCompliances OBJECT IDENTIFIER ::= { esCpuProtectMIBConformance 1 }

    esCpuProtectMIBCompliance MODULE-COMPLIANCE
        STATUS      current
	    DESCRIPTION
		    "The compliance statement for entities which implement the
		    DLINKES-CPU-PROTECT-MIB."
	    MODULE -- this module
	    MANDATORY-GROUPS { esCpuProtectProtoGroup }

	    GROUP esCpuProtectSubIntfGroup
	    DESCRIPTION
	        "This group is required only if the agent implements
		    the rate-limit for traffic destined to CPU by sub-interface type."
	    ::= { esCpuProtectMIBCompliances 1 }


    esCpuProtectMIBGroups OBJECT IDENTIFIER ::= { esCpuProtectMIBConformance 2 }

	esCpuProtectProtoGroup OBJECT-GROUP
	    OBJECTS
	        {   esCpuProtectProtoRLRate,
	            esCpuProtectProtoRLClearCounter,
			    esCpuProtectProtoRLCntTotalCnt,
		    	esCpuProtectProtoRLCntDropCnt
			}
	    STATUS      current
	    DESCRIPTION
		    "A collection of objects providing the configuration or
		    statistics about the rate-limit of traffic destined to
		    CPU by protocol type."
	    ::= { esCpuProtectMIBGroups 1 }

	esCpuProtectSubIntfGroup OBJECT-GROUP
	    OBJECTS
	        {   esCpuProtectSubIntfRLRate,
	            esCpuProtectSubIntfRLClearCounter,
		        esCpuProtectSubIntfRLCntTotalCnt,
		        esCpuProtectSubIntfRLCntDropCnt
		    }
	    STATUS      current
		DESCRIPTION
			"A collection of objects providing the configuration or
			statistics about the rate-limit of traffic destined to
			CPU by sub-interface type."
		::= { esCpuProtectMIBGroups 2 }

END

