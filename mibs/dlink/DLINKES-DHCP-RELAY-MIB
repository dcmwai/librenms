        ::= { esDhcpRPoolClassRelayTargetEntry 2 }

    esDhcpRPoClRelayTargetAddr OBJECT-TYPE
        SYNTAX          IpAddress
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This object indicates the IP address of the target server for
            the class."
        ::= { esDhcpRPoolClassRelayTargetEntry 4 }


    esDhcpRPoClRelayTargetRowStatus OBJECT-TYPE
