    esDhcpRPoolClassRelayTargetTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF EsDhcpRPoolClassRelayTargetEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A table that contains relay target class configuration for DHCP pools."
        ::= { esDhcpRPoolObjects 1 }

    esDhcpRPoolClassRelayTargetEntry OBJECT-TYPE
        SYNTAX      EsDhcpRPoolClassRelayTargetEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "By using DHCP class, DHCP relay uses option configuration to further
            determine which DHCP relay target for relaying the packet that
            matches the value pattern of option defined in the class."
        INDEX {
            esDhcpRPoClRelayTargetPoolName,
            esDhcpRPoClRelayTargetClassName,
            esDhcpRPoClRelayTargetAddr}
       ::= { esDhcpRPoolClassRelayTargetTable 1 }

