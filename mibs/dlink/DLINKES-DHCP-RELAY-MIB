    EsDhcpROption82ExUdfProfileEntry ::=     SEQUENCE {
        esDhcpROption82ExUdfProfileName      DisplayString,
        esDhcpROption82ExUdfProfileValue     DisplayString,
        esDhcpROption82ExUdfProfileRowStatus RowStatus
    }

