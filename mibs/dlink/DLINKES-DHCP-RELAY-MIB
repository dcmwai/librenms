        STATUS current
        DESCRIPTION
        "The compliance statement for entities which implement the
           DLINK-DHCP-RELAY-IPV4-MIB."
        MODULE -- this module
        MANDATORY-GROUPS {
            esDhcpRGblCfgGroup,
            esDhcpRPoolCfgGroup,
            esDhcpRInterfaceGroup2
        }

        GROUP       esDhcpROp82SuboptionGroup
        DESCRIPTION
            "This group is required only for implementations that support
            sub-options configuration of option 82."

        GROUP       esDhcpRVlanCfgGroup
        DESCRIPTION
            "This group is required only for implementations that support
            DHCP Local Relay for per VLAN."
        ::= { esDhcpRelayCompliances 1 }

