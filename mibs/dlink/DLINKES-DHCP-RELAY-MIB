    esDhcpRelayGeneral          OBJECT IDENTIFIER ::= { esDhcpRelayMIBObjects 1 }

    esDhcpRelayAgentInfoCheckEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates whether the DHCP relay agent validates the
             relay agent information option in the received DHCP reply packet."
        DEFVAL          { false }
        ::= { esDhcpRelayGeneral 1 }

    esDhcpRelayAgentInfoInsertEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates whether the DHCP relay agent inserts relay
            agent information option (option 82)."
        DEFVAL          { false }
        ::= { esDhcpRelayGeneral 2 }

    esDhcpRelayAgentInfoPolicy OBJECT-TYPE
        SYNTAX          INTEGER {  drop(1), keep(2), replace(3)}
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the re-forwarding policy of DHCP relay agent
             information option 82.
             drop (1)    - discards the packet that already has the relay
                           option.
             keep (2)    - the DHCP requests packet that already has the relay
                           option is left unchanged and directly relayed to the
                           DHCP server.
             replace (3) - the DHCP requests packet that already has the relay
                           option will be replaced by a new option."
        DEFVAL          { replace }
        ::= { esDhcpRelayGeneral 3 }

    esDhcpRelayInfoTrustAll OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates whether the DHCP relay agent trusts the DHCP
            relay information for all interfaces."
        DEFVAL          { false }
        ::= { esDhcpRelayGeneral 4 }

    esDhcpROption82RemoteIdType OBJECT-TYPE
        SYNTAX  INTEGER {
            default(1),
            userDefined(2),
            vendor2(4),
            expertUdf(6)
        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the type of remote ID sub-option.
            default(1)     - MAC address of VLAN 1.
            userDefined(2) - The value of esDhcpROption82RemoteID is used.
            vendor2(4)     - System Name.
            expertUdf(6)   - The flexible user defined format."
        ::= { esDhcpRelayGeneral 5 }

    esDhcpROption82RemoteIdUserDef OBJECT-TYPE
        SYNTAX          DisplayString (SIZE(0..32))
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the global user defined string as the remote
            ID of the device.
            This object can be modified when esDhcpROption82RemoteIdType is set
            to 'userDefined'.
            When read, a zero length string is returned when esDhcpROption82RemoteIdType
            is not 'userDefined'."
        ::= { esDhcpRelayGeneral 6 }

    esDhcpROption82CircuitIdType OBJECT-TYPE
        SYNTAX  INTEGER {
            default(1),
            userDefined(2),
            vendor1(3),
            expertUdf(9)
        }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the type of circuit ID sub-option.
            default(1)     - VLAN ID, Module ID and Port Number.
            userDefined(2) - The value of esDhcpROption82CircuitID is used.
            vendor1(3)     - VLAN ID, Slot ID, Port Number and MAC address of VLAN 1.
            expertUdf(9)   - The flexible user defined format."
        ::= { esDhcpRelayGeneral 7 }

    esDhcpROption82CircuitIdUserDef OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(0..32))
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "This object indicates the global user defined string as the circuit ID.
            This object can be modified when esDhcpROption82CircuitIdType is set
            to 'userDefined'.
            When read, a zero length string is returned when esDhcpROption82CircuitIdType
            is not 'userDefined'."
        ::= { esDhcpRelayGeneral 8 }

    esDhcpRelayUnicast OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the status of relaying DHCP client unicast packet."
        DEFVAL          { true }
        ::= { esDhcpRelayGeneral 9 }


