    esDhcpRIfAgentInfoChkTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsDhcpRIfAgentInfoChkEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A list of configurations about the DHCP relay validates the
            relay agent information (option 82) in the received DHCP reply packet
            on an interface.
            An entry is created/removed when checking option 82 is or not configured
            on an interface via CLI or by issuing appropriate sets to this table
            using snmp.
            If checking option 82 is not configured for an interface, the global
            setting, esDhcpRelayAgentInfoCheckEnabled takes effect. If checking
            option 82 is configured for an interface, the interface setting takes
            effect."
        ::= { esDhcpRelayIfObjects 2 }

    esDhcpRIfAgentInfoChkEntry OBJECT-TYPE
        SYNTAX          EsDhcpRIfAgentInfoChkEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Defines an entry in the esDhcpRIfInfoChkTable."
        INDEX  { esDhcpRIfAgentInfoChkIfIndex }
        ::= { esDhcpRIfAgentInfoChkTable 1 }

    EsDhcpRIfAgentInfoChkEntry ::= SEQUENCE {
        esDhcpRIfAgentInfoChkIfIndex         InterfaceIndex,
        esDhcpRIfAgentInfoChkState           INTEGER
    }

    esDhcpRIfAgentInfoChkIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The ifIndex value of the interface.
             Only VLAN interfaces are valid interfaces for this object."
        ::= { esDhcpRIfAgentInfoChkEntry 1 }

    esDhcpRIfAgentInfoChkState OBJECT-TYPE
