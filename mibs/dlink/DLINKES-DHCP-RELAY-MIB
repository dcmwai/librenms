        SYNTAX          DisplayString (SIZE(0..255))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the user defined format in circuit ID
             or remote ID. The particular format rules, please reference UIS."
        ::= { esDhcpROption82ExUdfProfileEntry 2 }

    esDhcpROption82ExUdfProfileRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object manages this entry."
        ::= { esDhcpROption82ExUdfProfileEntry 99}


     esDhcpROption82ExUdfMacFormatCase OBJECT-TYPE
        SYNTAX  INTEGER {
               uppercase(1),
               lowercase(2)
               }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the case format of the option82 MAC address for profile user define.
             It will be used in the object esDhcpROption82ExUdfProfileValue.

             uppercase: Using uppercase format, the formatted is: AA-BB-CC-DD-EE-FF.
             lowercase: Using lowercase format, the formatted is: aa-bb-cc-dd-ee-ff."
        ::= { esDhcpRelayOption82ExpertUdfObjects 2 }

     esDhcpROption82ExUdfMacFormatDelimiter OBJECT-TYPE
        SYNTAX  INTEGER {
               none(1),
               hyphen(2),
               colon(3),
               dot(4)
               }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the delimiter format of option82 MAC address for profile user define.
             It will be used in the object esDhcpROption82ExUdfProfileValue.

             none: Not using any delimiter, the format is: AABBCCDDEEFF
             hyphen: Using '-' as delimiter, the format is: AA-BB-CC-DD-EE-FF
             colon: Using ':' as delimiter, the format is: AA:BB:CC:DD:EE:FF
             dot: Using '.' as delimiter, the format is: AA.BB.CC.DD.EE.FF"
        ::= { esDhcpRelayOption82ExpertUdfObjects 3 }

     esDhcpROption82ExUdfMacFormatDelimiterNumber OBJECT-TYPE
        SYNTAX  INTEGER {
               oneDelimiterNumber(1),
               twoDelimiterNumber(2),
               fiveDelimiterNumber(5)
               }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the delimiter number of option82 MAC address for profile user define.
             It will be used in the object esDhcpROption82ExUdfProfileValue.

            oneDelimiterNumber: single delimiter, the format is: AABBCC.DDEEFF
            twoDelimiterNumber: double delimiter, the format is: AABB.CCDD.EEFF
            fiveDelimiterNumber: multiple delimiter, the format is: AA.BB.CC.DD.EE.FF
            Note: while esDhcpROption82ExUdfMacFormatDelimiter is none(1), the delimiter number will not take effect."
        ::= { esDhcpRelayOption82ExpertUdfObjects 4 }
