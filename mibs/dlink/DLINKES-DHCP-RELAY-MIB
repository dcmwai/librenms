    esDhcpRelayMIBNotifications    OBJECT IDENTIFIER ::= { dlinkEsDhcpRelayMIB 0 }
    esDhcpRelayMIBObjects          OBJECT IDENTIFIER ::= { dlinkEsDhcpRelayMIB 1 }
