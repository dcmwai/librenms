DLINKES-DHCP-RELAY-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        MODULE-IDENTITY,
        OBJECT-TYPE,
        IpAddress
                    FROM SNMPv2-SMI
        MODULE-COMPLIANCE,
        OBJECT-GROUP
                    FROM SNMPv2-CONF
        DisplayString,
        TruthValue,
        RowStatus
                    FROM SNMPv2-TC
        InterfaceIndex
                    FROM IF-MIB
        Dlink2kVlanList
                    FROM DLINKES-TC-MIB
        dlinkCommon
                    FROM DLINK-ID-REC-MIB;


    dlinkEsDhcpRelayMIB MODULE-IDENTITY
        LAST-UPDATED "201709260000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "        D-Link Corporation

             Postal: No. 289, Sinhu 3rd Rd., Neihu District,
                     Taipei City 114, Taiwan, R.O.C
             Tel:     +886-2-66000123
             E-mail: tsd@dlink.com.tw
            "
        DESCRIPTION
            "This MIB module defines objects for BOOTP/DHCP relay."

        REVISION "201709260000Z"
        DESCRIPTION
            "Remove unsuuported value of remote-ID and circuit-ID."

        REVISION "201708170000Z"
        DESCRIPTION
            "Remove not suuport key."

        REVISION "201702020000Z"
        DESCRIPTION
            "Modify mib object for EESDD."

        REVISION "201507070000Z"
        DESCRIPTION
             "1. Add the node dDhcpRRelayVlanCtrlTable"

        REVISION "201503310000Z"
        DESCRIPTION
            "1.Add the node dDhcpRIfAgentInfoStateCtrlTable."

        REVISION "201412150000Z"
        DESCRIPTION
            "1.Add the node dDhcpRelayAgentInfoIgnoreBootpEnabled.
             2.Deprecated the table dDhcpRIfIgnoreBootpTable."

        REVISION "201410140000Z"
        DESCRIPTION
            "1.Add the node dDhcpRelayAgentInfoInsertVPNEnabled and table dDhcpRIfAgentInfoInsertVPNTable to
               support the VPN-related suboptions for DHCP option 82.
             2. Add the node dDhcpRPoClRelayTargetVrfState and dDhcpRPoolRelayDestVrfState
               to support the virtual routing and forwarding (VRF).
             3. Modify the length for dDhcpROption82ExUdfProfileValue.
             4. Add the node dDhcpROption82RemoteExpertUdfUnitId and dDhcpROption82CircuitExpertUdfUnitId."

        REVISION "201403030000Z"
        DESCRIPTION
            "1.Add new Circuit ID type in dDhcpROption82CircuitIdType and dDhcpRPortIfOp82CirIdExpertUdfCfg: expertUdf(9).
             2.Add new Remote ID type in dDhcpROption82RemoteIdType and dDhcpRPortIfOp82RemIdExpertUdfCfg: expertUdf(6).
             3.Add dDhcpROption82ExUdfProfileTable, dDhcpROption82ExUdfMacFormatCase, dDhcpROption82ExUdfMacFormatDelimiter
              abd dDhcpROption82ExUdfMacFormatDelimiterNumber to support flexible user-defined DHCP option 82."

        REVISION "201401020000Z"
        DESCRIPTION
            "1.Update dDhcpROption82RemoteIdUserDef and dDhcpROption82CircuitIdUserDef value length(Note:follow UIS).
            2.Remove dDhcpRIfIgnoreBootpRowStatus and add dDhcpRIfIgnoreBootpEnabled(Note:follow IP interface).
            3.Remove dDhcpRIfAgentInfoChkRowStatus and modify dDhcpRIfAgentInfoChkState SYNTAX(Note:follow IP interface).
            4.Remove dDhcpRIfAgentInfoInsertRowStatus and modify dDhcpRIfAgentInfoInsertState SYNTAX(Note:follow IP interface).
            5.Remove dDhcpRIfAgentInfoPolicyRowStatus(Note:follow IP interface).
            6.Remove dDhcpRIfAgentInfoTrustRowStatus and add dDhcpRIfAgentInfoTrustEnabled(Note:follow IP interface)."

        REVISION "201309260000Z"
        DESCRIPTION
            "1.Modify dDhcpROption82RemoteIdUserDef and dDhcpROption82CircuitIdUserDef value length for IWL test.
             2.Update dDhcpRVlanLocalRelayCrlSecond2K description "

        REVISION "201307190000Z"
        DESCRIPTION
            "This is the first version of the MIB file for 'BOOTP/DHCP Relay'
             functionality."

        ::= { dlinkCommon 23 }

