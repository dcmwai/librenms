	esQosBandwidthCtrlTable OBJECT-TYPE
		SYNTAX          SEQUENCE OF EsQosBandwidthCtrlEntry
		MAX-ACCESS      not-accessible
		STATUS  current
		DESCRIPTION
		    "A table consists of a list of configurations for bandwidth control 
            on interfaces."
		::= { esQosBandwidthCtrl 1 }
	
	esQosBandwidthCtrlEntry OBJECT-TYPE
		SYNTAX          EsQosBandwidthCtrlEntry
		MAX-ACCESS      not-accessible
		STATUS  current
		DESCRIPTION
		    "An entry configures the bandwidth on an interface.
            An entry will exist for every applicable port.
            "
		INDEX   { dot1dBasePort }
		::= { esQosBandwidthCtrlTable 1 }
	
	EsQosBandwidthCtrlEntry ::=		SEQUENCE {		
		  esQosBandwidthRxRate		  Integer32,   
		  esQosBandwidthRxBurst	      Integer32,
		  esQosBandwidthTxRate	      Integer32,
		  esQosBandwidthTxBurst        Integer32,	
		  esQosBandwidthRxRateMode	  INTEGER,
		  esQosBandwidthTxRateMode	  INTEGER	     
		}
			
	esQosBandwidthRxRate OBJECT-TYPE
		SYNTAX          Integer32 (-1 | 64..10000000)
		MAX-ACCESS      read-write
		STATUS          current
		DESCRIPTION
		    "This object indicates Rx Rate of the specified port. 
		    The special value of -1 indicates there is no bandwidth 
		    limit for ingress packets.    
		    It is based on the esQosBandwidthRxRateMode field and
			if the esQosBandwidthRxRateMode selected as:
