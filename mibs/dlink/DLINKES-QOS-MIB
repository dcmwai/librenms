    esQosPoliceTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsQosPoliceEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table is used to configure the metering function. 
            Users may set the preferred bandwidth for this rule; once the 
            bandwidth has been exceeded, overflow packets will be either dropped
            or set for a drop precedence, depending on user configuration."
        ::= { esQosPolicyMap 4 }

    esQosPoliceEntry OBJECT-TYPE
        SYNTAX          EsQosPoliceEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This entry consists of configurations for the metering policing
            for a traffic class in a policy map."
        INDEX { 
            esQosPolicyMapName, 
            esQosClassMapName
        }
        ::= { esQosPoliceTable 1 }

    EsQosPoliceEntry ::=            SEQUENCE {
        esQosPoliceType                  INTEGER,
        esQosPoliceNamedAggPolicer 	    DisplayString,  
        esQosPoliceCir                   Unsigned32,
        esQosPoliceCbs                   Unsigned32,
        esQosPoliceSrtcmEbs              Unsigned32, 
        esQosPoliceTrtcmPir              Unsigned32,
        esQosPoliceTrtcmPbs              Unsigned32,                
        esQosPoliceConformAction         DlinkQosPoliceActionType,
        esQosPoliceConformReplaceDscp    Unsigned32,
        esQosPoliceExceedAction          DlinkQosPoliceActionType,
        esQosPoliceExceedReplaceDscp     Unsigned32,
        esQosPoliceViolateAction         DlinkQosPoliceActionType,
        esQosPoliceViolateReplaceDscp    Unsigned32,        	
        esQosPoliceColorAware            TruthValue,                     
        esQosPoliceRowStatus             RowStatus,
        esQosPoliceConformReplaceCos     Unsigned32,
        esQosPoliceExceedReplaceCos      Unsigned32,
        esQosPoliceViolateReplaceCos     Unsigned32
    }
        
    esQosPoliceType OBJECT-TYPE
        SYNTAX  INTEGER {  
            trTcm(1),
            singleRate(2),
            aggregate(3)
        }
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
            "This object indicates the type of policer used for a traffic class
            in a policy map.
            This object determines which other objects in the same row are meaningful.
            trTcm - two rate three color marker;
            singleRate - There are two kinds of single rate policers:
                a. single rate three color (srTcm) - if the violate action is specified 
                b. single rate two color - if the violate action is not specified.  
            aggregate - uses a named aggregate policer as the policy. In this case, 
                except index elements, esQosAggPolicer, and esQosPoliceRowStatus, other 
                elements in the same row are not applicable.               
            "
            ::= { esQosPoliceEntry 1 }
             
    esQosPoliceNamedAggPolicer OBJECT-TYPE               
        SYNTAX          DisplayString (SIZE(1..32))
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the name of the aggregate policer to be applied.
            This object is meaningful only when esQosPoliceType is 'aggregate'.  
            "
        ::= { esQosPoliceEntry 2 }
        
    esQosPoliceCir OBJECT-TYPE
        SYNTAX          Unsigned32 (0..10240000)
        UNITS           "kbps"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION 
            "This object is interpreted within the context of esQosPoliceType.
            The measurement unit is in kilobits per second.
            esQosPoliceType      esQosPoliceCir
            ==================  ===============================================
            'trTcm'             The committed information rate for first token 
                                bucket. 

            'singleRate'        The rate-limit for two-color policier. 
                                Or:
                                The committed information rate for srTcm. 

            'aggregate'         Not applicable
            "                                                                          
        ::= { esQosPoliceEntry 3 }
            
    esQosPoliceCbs OBJECT-TYPE
        SYNTAX          Unsigned32 (0..16384)
        UNITS	        "kbyte"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION       
            "This object is interpreted within the context of esQosPoliceType.            
            esQosPoliceType      esQosPoliceCbs
            ==================  ===============================================
            'trTcm'             The burst size for the first token bucket.

            'singleRate'        The burst size for two-color policier. 
                                Or:
                                The committed burst size for srTcm.     

            'aggregate'         Not applicable        
            The measurement unit is in kilobytes.
            The special value of 0 is used to indicate this object is not specified
            and the default value will be used. What's the default value is project-dependent.                   
            "                
        ::= { esQosPoliceEntry 4 }
        
    esQosPoliceSrtcmEbs OBJECT-TYPE
        SYNTAX          Unsigned32 (0..16384)
        UNITS	        "kbyte"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the excess burst size for srTcm and is 
            meaningless when esQosPoliceType is 'trTcm'.                 
            The measurement unit is in kilobytes.     
            The special value of 0 is used to indicate this object is not specified
            and the default value will be used. What's the default value is project-dependent.                                                         
            "  
        ::= { esQosPoliceEntry 5 }
    
    esQosPoliceTrtcmPir OBJECT-TYPE
        SYNTAX          Unsigned32 (0..10240000)
        UNITS           "kbps"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the peak information rate for the second
            token bucket for the two-rate metering. This object is only 
            meaningful when esQosPoliceType is 'trTcm'.
            The measurement unit is in kilobits per second.
            The special value of 0 is used to indicate this object is not specified
            and the default value will be used. What's the default value is project-dependent. 
            "
        ::= { esQosPoliceEntry 6 }

    esQosPoliceTrtcmPbs OBJECT-TYPE
        SYNTAX          Unsigned32 (0..16384)
        UNITS	        "kbyte"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the burst size for the second token bucket. 
            This object is meaningful only when esQosPoliceType is 'trTcm'.
            The measurement unit is in kilobytes.
            The special value of 0 is used to indicate this object is not specified
            and the default value will be used. What's the default value is project-dependent. 
            "  
        ::= { esQosPoliceEntry 7 }
   
    esQosPoliceConformAction OBJECT-TYPE
        SYNTAX          DlinkQosPoliceActionType
        MAX-ACCESS      read-create
        STATUS  current
        DESCRIPTION
            "This object indicates the action when the packet is in 'green color'.                           
            "
        ::= { esQosPoliceEntry 8 }

    esQosPoliceConformReplaceDscp OBJECT-TYPE
        SYNTAX          Unsigned32 (0..63)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the new DSCP value for esQosPoliceConformAction
            is 'replaceDscp' or 'replaceAll'."
        ::= { esQosPoliceEntry 9 }
            
    esQosPoliceExceedAction OBJECT-TYPE
        SYNTAX          DlinkQosPoliceActionType
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION       
            "This object is interpreted within the context of esQosPoliceType.
            
            esQosPoliceType      esQosPoliceExceedAction
            ==================  ===============================================
            'trTcm'             The action to take for those packets that conform
                                to PIR but not to CIR.  

            'singleRate'        The action to take on the packets exceed the rate 
                                limit (or committed burst size). 
            'aggregate'         Not applicable
                       
            "        
        ::= { esQosPoliceEntry 10 }

    esQosPoliceExceedReplaceDscp OBJECT-TYPE
        SYNTAX          Unsigned32 (0..63)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the new DSCP value when esQosPoliceExceedAction
            is 'replaceDscp' or 'replaceAll'.
            "
        ::= { esQosPoliceEntry 11 }

    esQosPoliceViolateAction OBJECT-TYPE
        SYNTAX          DlinkQosPoliceActionType
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the action state when the packet is in 'red color'.           
            "
        ::= { esQosPoliceEntry 12 }

    esQosPoliceViolateReplaceDscp OBJECT-TYPE
        SYNTAX          Unsigned32 (0..63)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the new DSCP value when esQosPoliceViolateAction
            is 'replaceDscp' or 'replaceAll'.
            "               
        ::= { esQosPoliceEntry 13 }

    esQosPoliceColorAware OBJECT-TYPE
        SYNTAX          TruthValue           
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
            "This object indicates whether the policer is color aware or not.
            This object is applied for esQosPoliceType is 'trTcm' or 'singleRate'. 
            "
        ::= { esQosPoliceEntry 14 }    
    
    esQosPoliceRowStatus OBJECT-TYPE
        SYNTAX  RowStatus
        MAX-ACCESS  read-create
        STATUS  current
        DESCRIPTION
            "This object indicates the status of this entry."
        ::= { esQosPoliceEntry 15 }	               

    esQosPoliceConformReplaceCos OBJECT-TYPE
        SYNTAX          Unsigned32 (0..7)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the new COS value for esQosPoliceConformAction
            is 'replaceCos' or 'replaceAll'.
            "
        ::= { esQosPoliceEntry 16 }	

    esQosPoliceExceedReplaceCos OBJECT-TYPE
        SYNTAX          Unsigned32 (0..7)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the new COS value when esQosPoliceExceedAction
            is 'replaceCos' or 'replaceAll'.
            "
        ::= { esQosPoliceEntry 17 }

    esQosPoliceViolateReplaceCos OBJECT-TYPE
        SYNTAX          Unsigned32 (0..7)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the new COS value when esQosPoliceViolateAction
            is 'replaceCos' or 'replaceAll'.
            "
        ::= { esQosPoliceEntry 18 }
