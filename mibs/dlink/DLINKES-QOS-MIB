   	esQosPolicyMapTable OBJECT-TYPE
		SYNTAX          SEQUENCE OF EsQosPolicyMapEntry
		MAX-ACCESS      not-accessible
		STATUS  current
		DESCRIPTION
		    "This table consists of a list of QoS policy maps."
		::= { esQosPolicyMap 1 }
    	   
	esQosPolicyMapEntry OBJECT-TYPE
		SYNTAX          EsQosPolicyMapEntry
		MAX-ACCESS      not-accessible
		STATUS          current
		DESCRIPTION
		    "An entry defines a QoS policy map."
		INDEX   { esQosPolicyMapName }
		::= { esQosPolicyMapTable 1 }

	EsQosPolicyMapEntry ::= 		SEQUENCE {     
		esQosPolicyMapName	      DisplayString,
		esQosPolicyMapRowStatus    RowStatus
    } 
	
	esQosPolicyMapName OBJECT-TYPE
		SYNTAX          DisplayString (SIZE(1..32))
		MAX-ACCESS      not-accessible		
		STATUS          current  
		DESCRIPTION
		    "This object indicates name of the policy map." 
		::= { esQosPolicyMapEntry 1 }	
		
	esQosPolicyMapRowStatus OBJECT-TYPE
		SYNTAX          RowStatus
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		      "This object indicates the status of this entry."
		::= { esQosPolicyMapEntry 2 }

-- ----------------------------------------------------------------------------- 	
   	esQosPolicyMapCfgTable OBJECT-TYPE
		SYNTAX          SEQUENCE OF EsQosPolicyMapCfgEntry
		MAX-ACCESS      not-accessible
		STATUS          current
		DESCRIPTION
		    "This table consists of a list of QoS policies for the class in a 
            policy map."
		::= { esQosPolicyMap 2 }
    	   
	esQosPolicyMapCfgEntry OBJECT-TYPE
		SYNTAX  EsQosPolicyMapCfgEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
		     "An entry consists QoS policies regarding setting the new precedence
             field, DSCP field, and CoS field of the out-going packet. 
             The first two index elements identify the policy map class to which
             the setting policies belong.   
             Multiple objects in a same row can be set for a class if they are not
             conflicting. As an example of conflicting setting: precedence and DSCP
             cannot be set at a same row.
             "
		INDEX   { 
            esQosPolicyMapName,
            esQosClassMapName 
        }
		::= { esQosPolicyMapCfgTable 1 }

	EsQosPolicyMapCfgEntry ::=		SEQUENCE {      		  
	    esQosPolicyMapCfgSetCosQueue         Integer32,  
		esQosPolicyMapCfgSetCos		        Integer32,                       
		esQosPolicyMapCfgSetDscpOnlyIp       TruthValue,		         
		esQosPolicyMapCfgSetDscp		        Integer32,       
		esQosPolicyMapCfgSetPreceOnlyIp 	    TruthValue,  		  
		esQosPolicyMapCfgSetPrecedence 	    Integer32,  
		esQosPolicyMapCfgRowStatus    	    RowStatus
    } 
		
   	esQosPolicyMapCfgSetCosQueue OBJECT-TYPE
		SYNTAX          Integer32 (-1 | 0..7)
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		    "Indicates the new CoS queue.
            The special value of -1 means the setting is un-configured."  
		DEFVAL {-1} 
		::= { esQosPolicyMapCfgEntry 1 }    
	
	esQosPolicyMapCfgSetCos OBJECT-TYPE
		SYNTAX          Integer32 (-1 | 0..7 )
		MAX-ACCESS      read-create
		STATUS  current
		DESCRIPTION
		      "Indicates the new Cos.
		      The special value of -1 means the setting is un-configured."     
		DEFVAL {-1}
		::= { esQosPolicyMapCfgEntry 2 }
	
    esQosPolicyMapCfgSetDscpOnlyIp OBJECT-TYPE
		SYNTAX          TruthValue
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		    "This object indicates whether only remark IPv4 DSCP.
            'true' - Only IPv4 DSCP will be marked.
		    'false'- Both IPv4 and IPv6 DSCP will be marked.
             This object is meaningful only when esQosPolicyMapCfgSetDscp is configured.
            "  
		DEFVAL { false }
		::= { esQosPolicyMapCfgEntry 3 }

	esQosPolicyMapCfgSetDscp OBJECT-TYPE
		SYNTAX          Integer32 ( -1 | 0..63 )
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		      "Indicates the new DSCP.
		      The special value of -1 means the setting is un-configured."   
		DEFVAL {-1} 
		::= { esQosPolicyMapCfgEntry 4 }
    
    esQosPolicyMapCfgSetPreceOnlyIp OBJECT-TYPE
		SYNTAX          TruthValue
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		    "This object indicates whether only remark IPv4 precedence.
		    'true' -  Ipv4 precedence will be marked.
		    'false' - Both IPv4 and IPv6 precedence will be marked. For IPv6
                packets, the precedence is most three significant bits of 
                traffic class of IPv6 header.
            This object is meaningful only when esQosPolicyMapCfgSetPrecedence is configured.
            "  
		DEFVAL { false }
		::= { esQosPolicyMapCfgEntry 5 }

	esQosPolicyMapCfgSetPrecedence OBJECT-TYPE
		SYNTAX          Integer32 (-1 | 0..7 )
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		    "Indicates the new ip precedence.  
		    The special value of -1 means the setting is un-configured."     
		DEFVAL {-1} 
		::= { esQosPolicyMapCfgEntry 6 }

	esQosPolicyMapCfgRowStatus OBJECT-TYPE
		SYNTAX          RowStatus
		MAX-ACCESS      read-create
		STATUS          current
		DESCRIPTION
		    "This object indicates the status of this entry."  
		::= { esQosPolicyMapCfgEntry 7 }
				    		 
