		    esDhcp6SPoolPdVLtime,
		    esDhcp6SPoolPdPLtime,
		    esDhcp6SPoolPdRowStatus,
		    esDhcp6SPoolPdLocPoolName,
		    esDhcp6SPoolPdLocPoolVLtime,
		    esDhcp6SPoolPdLocPoolPLtime,
