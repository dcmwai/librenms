	esDhcp6ServerCompliances OBJECT IDENTIFIER ::= { esDhcp6ServerMIBConformance 1 }

	esDhcp6ServerCompliance MODULE-COMPLIANCE
		STATUS current
		DESCRIPTION
			"The compliance statement for entities which implement the
			DLINKES-DHCP6-SERVER-MIB."
		MODULE -- this module
		MANDATORY-GROUPS {
		    esDhcp6SGblCfgGroup,
		    esDhcp6SLocalPoolGroup,
		    esDhcp6SPoolGroup,
		    esDhcp6SInterfaceGroup,
		    esDhcp6SNonTempAddrAssignGroup,
		    esDhcp6SInfoGroup
		}

		GROUP       esDhcp6SPrefixDelegationGroup
