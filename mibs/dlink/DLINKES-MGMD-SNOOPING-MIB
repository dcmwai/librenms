DLINKES-MGMD-SNOOPING-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        MODULE-IDENTITY, OBJECT-TYPE,
        NOTIFICATION-TYPE, IpAddress,
        TimeTicks, Counter64, Unsigned32      FROM SNMPv2-SMI
        RowStatus, DisplayString, TruthValue  FROM SNMPv2-TC
        TEXTUAL-CONVENTION                    FROM SNMPv2-TC
        MODULE-COMPLIANCE, OBJECT-GROUP       FROM SNMPv2-CONF
        InterfaceIndex, InterfaceIndexOrZero  FROM IF-MIB
        InetAddress, InetAddressType          FROM INET-ADDRESS-MIB
        VlanId, VlanIdOrNone                  FROM Q-BRIDGE-MIB
        dlinkCommon                           FROM DLINK-ID-REC-MIB;


    dlinkEsMgmdSnoopingMIB MODULE-IDENTITY
        LAST-UPDATED "201408180000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "        D-Link Corporation

             Postal: No. 289, Sinhu 3rd Rd., Neihu District,
                     Taipei City 114, Taiwan, R.O.C
             Tel:     +886-2-66000123
             E-mail: tsd@dlink.com.tw
            "
        DESCRIPTION
            "This MIB module defines objects for MGMD (Multicast Group
            Membership Discovery) snooping."
        REVISION "202004160000Z"
	    DESCRIPTION
        "Add New objects esMgmdSnpIfQuerier and
        esMgmdSnpIfQuerierExpiryTime
        "
        REVISION "201408180000Z"
	    DESCRIPTION 
	    	"Add New objects 'esMgmdSnpClearAllUnknownDataGroup', 
	    	     'esMgmdSnpClearIgmpSnoopUnknownDataGroupByGrpAddr',
	             'esMgmdSnpClearMldSnoopUnknownDataGroupByGrpAddr',
				 'esMgmdSnpClearIgmpSnoopUnknownDataGroupByVlanId',
				 'esMgmdSnpClearMldSnoopUnknownDataGroupByVlanId',
				 'esMgmdSnpIgmpSnoopDynamicMrouteAgingTime', 'esMgmdSnpMldSnoopDynamicMrouteAgingTime',
				 'esMgmdSnpIgmpSnoopUnknownDataLimit', 'esMgmdSnpMldSnoopUnknownDataLimit' 
				 to 'esMgmdSnpGlobalCtrl'.
			 Add new objects 'esMgmdSnpIfLimitExceedAction' to 'esMgmdSnpIfLimitTable'. 
			 Add new table 'esMgmdSnpPortIfTable'.
			"
      
        REVISION "201407180000Z"
	    DESCRIPTION 
	    	"Modify the OID of all rowstatus objects to 99."
	 
        REVISION "201311080000Z"
        DESCRIPTION
            "Add new objects esMgmdSnpIfIgnoreTopologyChgNotification
            to esMgmdSnpIfTable."
            
        REVISION "201309050000Z"
        DESCRIPTION
            "Add new objects esMgmdSnpIfQueryInterval, 
            esMgmdSnpIfQueryMaxResponseTime, esMgmdSnpIfQueryVersion, 
            esMgmdSnpIfRobustness, esMgmdSnpIfLastMemberQueryInterval, 
            and esMgmdSnpIfSuppressionTime to esMgmdSnpIfTable.
            
            Split table esMgmdSnpGroupTable into two tables, there are 
            esMgmdSnpGroupTable and esMgmdSnpStaticGrpTable. 
            The table esMgmdSnpGroupTable listing MGMD snooping dynamic
            groups; table esMgmdSnpStaticGrpTable manage MGMD snooping
            static groups.
            
            Split table esMgmdSnpGroupSrcTable into two tables, there are 
            esMgmdSnpGroupSrcTable and esMgmdSnpStaticGrpSrcTable. 
            The table esMgmdSnpGroupSrcTable listing MGMD snooping dynamic
            group source entries; table esMgmdSnpStaticGrpSrcTable manage 
            MGMD snooping static group source entries.
            
            Revision some spelling error and objects description."
            
        REVISION "201301290000Z"
        DESCRIPTION
            "This is the first version of the MIB file for 'MGMD snooping'
            functionality."

    ::= { dlinkCommon 6 }

-- 
-- Textual Conventions
--
SnoopingType ::= TEXTUAL-CONVENTION
    STATUS       current
    DESCRIPTION
        "The snooping type.

        'igmpSnooping' -- IGMP (IPv4 MGMD) snooping. 

        'mldSnooping' -- MLD (IPv6 MGMD) snooping.
        "    
            
    SYNTAX     INTEGER {
        igmpSnooping(1),
        mldSnooping(2)
    }
-- -----------------------------------------------------------------------------
    esMgmdSnpMIBNotifications   OBJECT IDENTIFIER ::= { dlinkEsMgmdSnoopingMIB 0 }
    esMgmdSnpMIBObjects         OBJECT IDENTIFIER ::= { dlinkEsMgmdSnoopingMIB 1 }
    esMgmdSnpMIBConformance     OBJECT IDENTIFIER ::= { dlinkEsMgmdSnoopingMIB 2 }

-- -----------------------------------------------------------------------------
    esMgmdSnpGlobalCtrl         OBJECT IDENTIFIER ::= { esMgmdSnpMIBObjects 1 }
    
    esMgmdSnpStateGblEnabled OBJECT-TYPE
        SYNTAX BITS {
            ipv4(0),
            ipv6(1)  }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "An object indicates which type of MGMD is globally enabled.
            Setting a type's bit to 1 means the type of MGMD is globally 
            enabled.
            ipv4 (0)    - IGMP snooping
            ipv6 (1)    - MLD snooping." 
        ::= { esMgmdSnpGlobalCtrl 1 }
        
    esMgmdSnpClearAllState OBJECT-TYPE
        SYNTAX      INTEGER {
            notClear(1),
            igmpClear(2),
            mldClear(3)
        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the global state of MGMD snooping statistics 
            function. Configuring this object to igmpClear or mldClear will clear
            all respective MGMD snooping counters."
        ::= { esMgmdSnpGlobalCtrl 2 }
        
    esMgmdSnpClearIgmpSnoopByPortIf OBJECT-TYPE
        SYNTAX          InterfaceIndexOrZero
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the ifIndex of the port/port-channel on which 
           the IGMP snooping counters will be cleared.
           When read, the special value 0 is returned."
        ::= { esMgmdSnpGlobalCtrl 3 }
    
    esMgmdSnpClearMldSnoopByPortIf OBJECT-TYPE
        SYNTAX          InterfaceIndexOrZero
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the ifIndex of the port/port-channel on which 
           the MLD snooping counters will be cleared.
           When read, the special value 0 is returned."
        ::= { esMgmdSnpGlobalCtrl 4 }
    
    esMgmdSnpClearIgmpSnoopByVlanId OBJECT-TYPE
        SYNTAX          VlanIdOrNone
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the VLAN ID on which the IGMP snooping 
           counters will be cleared.
           When read, the special value 0 is returned."
        ::= { esMgmdSnpGlobalCtrl 5 }
    
    esMgmdSnpClearMldSnoopByVlanId OBJECT-TYPE
        SYNTAX          VlanIdOrNone           
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the VLAN ID on which the MLD snooping counters
           will be cleared.
           When read, the special value 0 is returned."    
        ::= { esMgmdSnpGlobalCtrl 6 }  
        
    esMgmdSnpClearAllUnknownDataGroup OBJECT-TYPE
        SYNTAX      INTEGER {
            notClear(1),
            igmpClear(2),
            mldClear(3)
        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the clear status of MGMD snooping unknown data groups. 
            Configuring this object to igmpClear or mldClear will clear all unknown data
            groups learned by MGMD snooping."
        ::= { esMgmdSnpGlobalCtrl 7 }
        
    esMgmdSnpClearIgmpSnoopUnknownDataGroupByGrpAddr OBJECT-TYPE
        SYNTAX          InetAddress (SIZE(4|16))
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the multicast group address of IGMP snooping unknown data 
           groups will be cleared.
           When read, the special value 0 is returned."
        ::= { esMgmdSnpGlobalCtrl 8 }
    
    esMgmdSnpClearMldSnoopUnknownDataGroupByGrpAddr OBJECT-TYPE
        SYNTAX          InetAddress (SIZE(4|16))
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the multicast group address of MLD snooping unknown data 
           groups will be cleared.
           When read, the special value 0 is returned."
        ::= { esMgmdSnpGlobalCtrl 9 }
    
    esMgmdSnpClearIgmpSnoopUnknownDataGroupByVlanId OBJECT-TYPE
        SYNTAX          VlanIdOrNone
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the VLAN ID on which the IGMP snooping unknown
           data groups will be cleared.
           When read, the special value 0 is returned."
        ::= { esMgmdSnpGlobalCtrl 10 }
    
    esMgmdSnpClearMldSnoopUnknownDataGroupByVlanId OBJECT-TYPE
        SYNTAX          VlanIdOrNone           
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the VLAN ID on which the MLD snooping unknown
           data groups will be cleared.
           When read, the special value 0 is returned."    
        ::= { esMgmdSnpGlobalCtrl 11 }

    esMgmdSnpIgmpSnoopDynamicMrouteAgingTime OBJECT-TYPE
        SYNTAX          Unsigned32 (10..65535)
        UNITS           "seconds"
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the aging time of dynamic multicat router ports
           learned by IGMP snooping."    
        ::= { esMgmdSnpGlobalCtrl 12 }
    
    esMgmdSnpMldSnoopDynamicMrouteAgingTime OBJECT-TYPE
        SYNTAX          Unsigned32 (10..65535)
        UNITS           "seconds"
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the aging time of dynamic multicat router ports
           learned by MLD snooping."    
        ::= { esMgmdSnpGlobalCtrl 13 }
        
    esMgmdSnpIgmpSnoopUnknownDataLimit OBJECT-TYPE
        SYNTAX          Unsigned32 
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the maximum group entry number learned from unknown 
           multicast data by IGMP Snooping."    
        ::= { esMgmdSnpGlobalCtrl 14 }  
        
    esMgmdSnpMldSnoopUnknownDataLimit OBJECT-TYPE
        SYNTAX          Unsigned32 
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
           "This object indicates the maximum group entry number learned from unknown 
           multicast data by MLD Snooping."    
        ::= { esMgmdSnpGlobalCtrl 15 }    
-- -----------------------------------------------------------------------------
    esMgmdSnpVlanIfCtrl           OBJECT IDENTIFIER ::= { esMgmdSnpMIBObjects 2 }
    
    esMgmdSnpIfTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsMgmdSnpIfEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table lists the MGMD snooping settings per interface. 
            An entry is created to configure the MGMD snooping related settings
            to different value than the default per interface.
            When an entry is deleted, all the MGMD snooping settings will be
            reverted to default settings."
        ::= { esMgmdSnpVlanIfCtrl 1 }

    esMgmdSnpIfEntry OBJECT-TYPE
        SYNTAX          EsMgmdSnpIfEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table entry represents the MGMD snooping state on a VLAN
             basis."
        INDEX    { 
            esMgmdSnpIfVlanIfIndex , 
            esMgmdSnpIfSnoopingType
        }
        ::= { esMgmdSnpIfTable 1 }

    EsMgmdSnpIfEntry ::= SEQUENCE {
        esMgmdSnpIfVlanIfIndex               InterfaceIndex,
        esMgmdSnpIfSnoopingType              SnoopingType,
        esMgmdSnpIfStateEnabled              TruthValue,
        esMgmdSnpIfQuerierStateEnabled       TruthValue,
        esMgmdSnpIfQuerierRouter             INTEGER,
        esMgmdSnpIfFastLeaveEnabled          TruthValue,
        esMgmdSnpIfFastLeaveHostBased        TruthValue,
        esMgmdSnpIfMinimumVersion            INTEGER,
        esMgmdSnpIfExplicitTrackEnabled      TruthValue,
        esMgmdSnpIfReportSuppresEnabled      TruthValue,
        esMgmdSnpIfProxyReportingEnabled     TruthValue,
        esMgmdSnpIfProxyReportSrcAddrType    InetAddressType,
        esMgmdSnpIfProxyReportSrcAddr        InetAddress,
        esMgmdSnpIfQueryInterval             Unsigned32,
        esMgmdSnpIfQueryMaxResponseTime      Unsigned32,
        esMgmdSnpIfQueryVersion              Unsigned32,
        esMgmdSnpIfRobustness                Unsigned32,
        esMgmdSnpIfLastMemberQueryInterval   Unsigned32,
        esMgmdSnpIfSuppressionTime           Unsigned32,
        esMgmdSnpIfIgnoreTopologyChgNotification      TruthValue,   
        esMgmdSnpIfRateLimit                 Unsigned32,
        esMgmdSnpIfUnknownDataLearnState     TruthValue,  
        esMgmdSnpIfUnknownDataGroupExpiryTime       Unsigned32,
        esMgmdSnpIfQuerier                   InetAddress,
        esMgmdSnpIfQuerierExpiryTime         Unsigned32,
        esMgmdSnpIfRowStatus                 RowStatus
    }
         
    esMgmdSnpIfVlanIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Indicates the specific VLAN interface."
        ::= { esMgmdSnpIfEntry 1 }

    esMgmdSnpIfSnoopingType OBJECT-TYPE
        SYNTAX          SnoopingType
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The snooping type of this entry."
        ::= { esMgmdSnpIfEntry 2 }

    esMgmdSnpIfStateEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the state of MGMD snooping of the entry."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 4 }

    esMgmdSnpIfQuerierStateEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the MGMD query function in Layer 2 networks."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 5 }

    esMgmdSnpIfQuerierRouter OBJECT-TYPE
        SYNTAX          INTEGER { 
            absence(1), 
            active(2), 
            nonActive(3)
        }
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "Indicates the VLAN interface at the switch system works as a
            MGMD querier or not. A value of absence(1) indicates the absence of
            this attribute."
        ::= { esMgmdSnpIfEntry 6 }

    esMgmdSnpIfFastLeaveEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object enables the MGMD snooping fast-leave feature on the
            interface."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 7 }

    esMgmdSnpIfFastLeaveHostBased OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object configures the MGMD Snooping Host Based Fast Leave 
            function."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 8 }
        
    esMgmdSnpIfMinimumVersion OBJECT-TYPE
        SYNTAX      INTEGER { 
            disabled(1), 
            version2(2), 
            version3(3) }
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "To restrict the minimum version allows user to control the minimum
             version of MGMD hosts can be joined on a layer 2 port. The value 
             '0' means that this interface does not restrict the minimum version.
             Value 2 applies to IGMP routers only.  Value 3 applies to IGMP and
             MLD routers."
        DEFVAL      { 1 }
        ::= { esMgmdSnpIfEntry 9 }

    esMgmdSnpIfExplicitTrackEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object enables explicit tracking of group membership for IGMP
            Version 3 hosts on the interface."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 10 }
 
    esMgmdSnpIfReportSuppresEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object enables the report suppression on the interface."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 11 }
    
    esMgmdSnpIfProxyReportingEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object enables the proxy-reporting function on the interface."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 12 }    
        
    esMgmdSnpIfProxyReportSrcAddrType OBJECT-TYPE
        SYNTAX          InetAddressType 
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the type of Internet address 
             of the source IP of proxy reporting."
        DEFVAL { ipv4 }
        ::= { esMgmdSnpIfEntry 14 }      
        
     esMgmdSnpIfProxyReportSrcAddr OBJECT-TYPE
        SYNTAX          InetAddress
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the source Internet address 
             of proxy reporting. This object is valid when 
             esMgmdSnpIfProxyReportingEnabled is 'true'."
        DEFVAL { '00000000'h }
        ::= { esMgmdSnpIfEntry 15 }
        
    esMgmdSnpIfQueryInterval OBJECT-TYPE
        SYNTAX          Unsigned32 (1..31744)
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The frequency at which IGMP or MLD Query packets are
            transmitted on this interface."
        DEFVAL      { 125 }
        ::= { esMgmdSnpIfEntry 16 }
        
    esMgmdSnpIfQueryMaxResponseTime OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The maximum query response interval advertised in IGMP 
            or MLD queries on this interface."
        ::= { esMgmdSnpIfEntry 17 }
        
    esMgmdSnpIfQueryVersion OBJECT-TYPE
        SYNTAX          Unsigned32 (1..3)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The version of MGMD querier version on this interface.
            Value 1 applies to IGMPv1 routers only.  Value 2 applies
            to IGMPv2 and MLDv1 routers, and value 3 applies to IGMPv3
            and MLDv2 routers."
        DEFVAL      { 3 }
        ::= { esMgmdSnpIfEntry 18 }
        
    esMgmdSnpIfRobustness OBJECT-TYPE
        SYNTAX          Unsigned32 (1..7)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The Robustness Variable allows tuning for the expected
            packet loss on a subnet."
        DEFVAL      { 2 }
        ::= { esMgmdSnpIfEntry 19 }
        
    esMgmdSnpIfLastMemberQueryInterval OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The amount of time between group-specific query messages.
            This value can be tuned to modify the leave latency of the 
            network."
        DEFVAL      { 1 }
        ::= { esMgmdSnpIfEntry 20 }
        
    esMgmdSnpIfSuppressionTime OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The interval of report suppression on this interface."
        ::= { esMgmdSnpIfEntry 21 }

    esMgmdSnpIfIgnoreTopologyChgNotification  OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates MGMD ignore STP change and won't send 
            STP-triggered-query on the interface."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 22 }
    
    esMgmdSnpIfRateLimit  OBJECT-TYPE
        SYNTAX          Unsigned32
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the rate of the MGMD control packets that 
            the switch can process on the interface. 
            If the value of this object is set to 0, the MGMD control packets
            processing is not limitation.
            The rate is specified in packets per second."
        ::= { esMgmdSnpIfEntry 23 }
    
   esMgmdSnpIfUnknownDataLearnState  OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the state of unknown data group learning function
            on the interface."
        DEFVAL      { false }
        ::= { esMgmdSnpIfEntry 24 } 
        
    esMgmdSnpIfUnknownDataGroupExpiryTime OBJECT-TYPE
        SYNTAX          Unsigned32 (0..65535)
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the life time of MGMD snooping unknown data groups.
            If the value of this oject is set to 0, the MGMD snooping unknown data 
            groups won't be aged out."
        ::= { esMgmdSnpIfEntry 25 }

    esMgmdSnpIfQuerier OBJECT-TYPE
      SYNTAX     InetAddress
      MAX-ACCESS read-only
      STATUS     current
      DESCRIPTION
            "The address of the Querier on the interface.
            The type of address is determined by dMgmdSnpIfSnoopingType."
    ::= { esMgmdSnpIfEntry 26 }

    esMgmdSnpIfQuerierExpiryTime OBJECT-TYPE
      SYNTAX     Unsigned32
      UNITS      "seconds"
      MAX-ACCESS read-only
      STATUS     current
      DESCRIPTION
            "The amount of time remaining before the Other Querier
            Present Timer expires.  If the local system is the querier,
            the value of this object is zero."
    ::= { esMgmdSnpIfEntry 27 }

        
    esMgmdSnpIfRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
           "The status of this conceptual row." 
        ::= { esMgmdSnpIfEntry 99 }
-- -----------------------------------------------------------------------------
    esMgmdSnpPortIfCtrl           OBJECT IDENTIFIER ::= { esMgmdSnpMIBObjects 3 }

    esMgmdSnpMrouterTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsMgmdSnpMrouterEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The table to display and configure the MGMD snooping multicast
            router information. An entry is created if a multicast router is
            is learned dynamically on that port/port-channel interface 
            (esMgmdSnpIfAutoLearnMrouter is 'true' on the VLAN interface). In 
            this situation, an entry cannot be destroyed.
            An entry can also be created to statically configured a multicast 
            router port or forbid a port/port-channel become multicast router
            port."
        ::= { esMgmdSnpPortIfCtrl 1 }

    esMgmdSnpMrouterEntry OBJECT-TYPE
        SYNTAX          EsMgmdSnpMrouterEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry in the esMgmdSnpMrouterTable."
        INDEX  { 
            esMgmdSnpMrouterIfIndex,
            esMgmdSnpMrouterVlanIfIndex,
            esMgmdSnpMrouterQuerierType
        }
        ::= { esMgmdSnpMrouterTable 1 }

    EsMgmdSnpMrouterEntry ::= SEQUENCE {
        esMgmdSnpMrouterIfIndex              InterfaceIndex,
        esMgmdSnpMrouterVlanIfIndex          InterfaceIndex,
        esMgmdSnpMrouterQuerierType          SnoopingType,
        esMgmdSnpMrouterAdminState           INTEGER,
        esMgmdSnpMrouterDynamicMrouter       TruthValue,
        esMgmdSnpMrouterStatus               RowStatus
    }
    
    esMgmdSnpMrouterIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Indicates the specific physical port/port-channel interface"
        ::= { esMgmdSnpMrouterEntry 1 }
        
    esMgmdSnpMrouterVlanIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Indicates the specific VLAN interface."
        ::= { esMgmdSnpMrouterEntry 2 }

    esMgmdSnpMrouterQuerierType OBJECT-TYPE
        SYNTAX          SnoopingType
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The snooping type of this interface."
        ::= { esMgmdSnpMrouterEntry 3 }
     
    esMgmdSnpMrouterAdminState OBJECT-TYPE
        SYNTAX      INTEGER { 
            none(1), 
            designated(2), 
            forbidden(3) }
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the static configuration about multicast
            router state of a port/port-channel on a per-VLAN basis. 
            none(1) - no static configuration
            designated(2) - the port/port-channel is a static multicast router 
                           port.
            forbidden(3) - the port/port-channel cannot be multicast router
                           port."
        DEFVAL      { 1 }
        ::= { esMgmdSnpMrouterEntry 5 }
               
     esMgmdSnpMrouterDynamicMrouter OBJECT-TYPE
        SYNTAX          TruthValue 
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object is valid when esMgmdSnpMrouterAdminState is 'none'.
            This object indicates the port/port-channel is dynamically learned
            as a multicast router port on the corresponding VLAN interface."
        ::= { esMgmdSnpMrouterEntry 6 }
     
    esMgmdSnpMrouterStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The status of this conceptual row."
        ::= { esMgmdSnpMrouterEntry 99 }              
-- -----------------------------------------------------------------------------
    esMgmdSnpIfLimitTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF EsMgmdSnpIfLimitEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "The table to set the limitation on the number of MGMD cache entries.
            For a Layer 2 VLAN on a trunk port, the limitation can be set per
            port/port-channel and on per VLAN basis."
        ::= { esMgmdSnpPortIfCtrl 2 }

    esMgmdSnpIfLimitEntry OBJECT-TYPE
        SYNTAX          EsMgmdSnpIfLimitEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
