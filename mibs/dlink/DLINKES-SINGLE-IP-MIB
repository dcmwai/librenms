DLINKES-SINGLE-IP-MIB DEFINITIONS ::= BEGIN

IMPORTS
    ifIndex
                    FROM RFC1213-MIB
    NOTIFICATION-TYPE, MODULE-IDENTITY, OBJECT-TYPE,
    Integer32
                    FROM SNMPv2-SMI
    MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP
                    FROM SNMPv2-CONF
    DisplayString, MacAddress
                    FROM SNMPv2-TC
    dlinkCommon
                    FROM DLINK-ID-REC-MIB;

    dlinkEsSingleIpMIB MODULE-IDENTITY
        LAST-UPDATED "201708070000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "http://support.dlink.com"
        DESCRIPTION
            "The Single IP management MIB."

        REVISION    "201708070000Z"
        DESCRIPTION
             "Update for ESSDD."

        REVISION    "200901210000Z"
        DESCRIPTION
             "This is the first version of the MIB file.
             "

        ::= { dlinkCommon 225}


    esSingleIpMSNotify      OBJECT IDENTIFIER ::= { dlinkEsSingleIpMIB 0 }
    esSingleIpMgmt          OBJECT IDENTIFIER ::= { dlinkEsSingleIpMIB 1 }
    esSingleIpConformance   OBJECT IDENTIFIER ::= { dlinkEsSingleIpMIB 2 }

-- -----------------------------------------------------------------------------
    esSingleIpInfo          OBJECT IDENTIFIER ::= { esSingleIpMgmt 1 }
    esSingleIpCtrl          OBJECT IDENTIFIER ::= { esSingleIpMgmt 2 }

-- -----------------------------------------------------------------------------
-- esSingleIpInfo
-- -----------------------------------------------------------------------------
    esSingleIpVersion OBJECT-TYPE
        SYNTAX  DisplayString  (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object indicates the version of Single IP Management supported in the system."
        ::= { esSingleIpInfo 1}

    esSingleIpCapability OBJECT-TYPE
        SYNTAX  DisplayString  (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object indicates the capability of the switch system."
        ::= { esSingleIpInfo 2}

    esSingleIpPlatform OBJECT-TYPE
        SYNTAX  DisplayString  (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object indicates the platform of the switch system."
        ::= { esSingleIpInfo 3}

    esSingleIpFirmwareVer OBJECT-TYPE
        SYNTAX  DisplayString  (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object indicates the firmware version of the switch system."
        ::= { esSingleIpInfo 4}

    esSingleIpDeviceName OBJECT-TYPE
        SYNTAX  DisplayString  (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object indicates the device name of the switch system."
        ::= { esSingleIpInfo 5}

    esSingleIpMacAddr OBJECT-TYPE
        SYNTAX  MacAddress
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object specifies the MAC address of the switch system."
        ::= { esSingleIpInfo 6}

-- -----------------------------------------------------------------------------
-- esSingleIpCtrl
-- -----------------------------------------------------------------------------
    esSingleIpAdmin OBJECT-TYPE
        SYNTAX  INTEGER {
                    other(1),
                    disabled(2),
                    enabled(3)
                }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates Single IP Management is enabled or disabled on the system."
        ::= { esSingleIpCtrl 1}

    esSingleIpRoleState OBJECT-TYPE
        SYNTAX  INTEGER {
                    cs(1),
                    cas(2),
                    ms(3)
                }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the role state of the switch system."
        ::= { esSingleIpCtrl 2}

    esSingleIpHoldtime OBJECT-TYPE
        SYNTAX  Integer32 (100..255)
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicate the holdtime of the switch in seconds.
             The default value is 100, the maximum value is 255, and the minimum value is 100."
        DEFVAL { 100 }
        ::= { esSingleIpCtrl 3 }

    esSingleIpTimeInterval OBJECT-TYPE
        SYNTAX  Integer32 (30..90)
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the time interval of the switch in seconds to
             periodically send out Single IP protocol control packets.
             The default value is 60, the maximum value is 120, and the minimum value is 30.
             The esSingleIpTimeInterval will always <= esSingleIpHoldtime/2."
        DEFVAL { 30 }
        ::= { esSingleIpCtrl 4 }

    esSingleIpCSGroupName OBJECT-TYPE
        SYNTAX    DisplayString  (SIZE (0..64))
        MAX-ACCESS read-write
        STATUS current
        DESCRIPTION
            "This object is used to configure the group name for the commander switch."
        ::= { esSingleIpCtrl 5 }

    esSingleIpMgmtVlan OBJECT-TYPE
        SYNTAX    Integer32 (1..4094)
        MAX-ACCESS read-write
        STATUS current
        DESCRIPTION
            "This object is used to configure the SIM management VLAN."
        ::= { esSingleIpCtrl 7 }

-- -----------------------------------------------------------------------------
-- esSingleIpTrapMgmt
-- -----------------------------------------------------------------------------

    esSingleIpTrapMgmt OBJECT IDENTIFIER ::= { esSingleIpCtrl 6 }

    esSingleIpTrapStatus OBJECT-TYPE
        SYNTAX  INTEGER {
               enabled(1),
               disabled(2)
            }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "When enabled (1), whenever the commander detects a member's trap
             event, a trap will be sent out."
        ::= { esSingleIpTrapMgmt 1 }

-- -----------------------------------------------------------------------------
-- esSingleIpMSTable
-- -----------------------------------------------------------------------------

    esSingleIpMSTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF EsSingleIpMSEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This table contains information about member switches which belong to the
            single IP management group.
             A member will be joined into the group by row creation.
             Before a switch is joined into a group as a member switch,
             it must exist in the candidate table list."
        ::= { esSingleIpMgmt 3 }

    esSingleIpMSEntry OBJECT-TYPE
        SYNTAX  EsSingleIpMSEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "A list of information about member switches that belong to the single IP
             management group."
        INDEX  { esSingleIpMSMacAddr }
        ::= { esSingleIpMSTable 1 }

    EsSingleIpMSEntry ::=
        SEQUENCE {
            esSingleIpMSMacAddr         MacAddress,
            esSingleIpMSDeviceName      DisplayString,
            esSingleIpMSOperate         INTEGER,
            esSingleIpMSFirmwareVer     DisplayString,
            esSingleIpMSCapability      DisplayString,
            esSingleIpMSPlatform        DisplayString,
            esSingleIpMSHoldtime        Integer32,
            esSingleIpMSCfgStatus       INTEGER
        }

    esSingleIpMSMacAddr OBJECT-TYPE
        SYNTAX  MacAddress
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This object specifies the MAC address of the member switch."
        ::= { esSingleIpMSEntry 1 }

    esSingleIpMSDeviceName OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the name of switch."
        ::= { esSingleIpMSEntry 2 }

    esSingleIpMSOperate OBJECT-TYPE
        SYNTAX  INTEGER {
                    noOp(1),
                    transformToCaS(2)
                }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object is used to control entry state.
             It will transform to CaS table when set to 'transformToCaS'.
             No action is taken if this object is set to 'noOp'.
             When read, the value 'noOp' is returned."
        ::= { esSingleIpMSEntry 3 }

    esSingleIpMSFirmwareVer OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the firmware version of the switch."
        ::= { esSingleIpMSEntry 4 }

    esSingleIpMSCapability OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the capability of the switch."
        ::= { esSingleIpMSEntry 5 }

    esSingleIpMSPlatform OBJECT-TYPE
        SYNTAX   DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the platform of the switch."
        ::= { esSingleIpMSEntry 6 }

    esSingleIpMSHoldtime OBJECT-TYPE
        SYNTAX  Integer32
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the holdtime of Single IP Management protocol sent by
            this member switch."
        ::= { esSingleIpMSEntry 7 }        
        
    esSingleIpMSCfgStatus OBJECT-TYPE
        SYNTAX  INTEGER {
                    normal(1),
                    waiting(2)
                }
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the config ACK status of this device. 
            allow: device can send a config packet
            not-allow: device still wait for config ACK."
        ::= { esSingleIpMSEntry 8 }


-- -----------------------------------------------------------------------------
-- esSingleIpCaSTable
-- -----------------------------------------------------------------------------
    esSingleIpCaSTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF EsSingleIpCaSEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This table contains information about candidate switches.
             This table is a read-only table listing all information about candidate
             switches that will be maintained automatically by the Single IP topology discovery
             protocol.  "
        ::= { esSingleIpMgmt 4 }

    esSingleIpCaSEntry OBJECT-TYPE
        SYNTAX  EsSingleIpCaSEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "A list of information about candidate switches that belong to the Single
             IP Management group."
        INDEX  { esSingleIpCaSMacAddr }
        ::= { esSingleIpCaSTable 1 }

    EsSingleIpCaSEntry ::=
        SEQUENCE {
            esSingleIpCaSMacAddr            MacAddress,
            esSingleIpCaSDeviceName         DisplayString,
            esSingleIpCaSOperate            INTEGER,
            esSingleIpCaSFirmwareVer        DisplayString,
            esSingleIpCaSCapability         DisplayString,
            esSingleIpCaSPlatform           DisplayString,
            esSingleIpCaSHoldtime           Integer32,
            esSingleIpCasPassword           DisplayString,
            esSingleIpCaSCfgStatus          INTEGER
        }

    esSingleIpCaSMacAddr OBJECT-TYPE
        SYNTAX  MacAddress
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This object specifies the MAC address of the candidate switch."
        ::= { esSingleIpCaSEntry 1 }

    esSingleIpCaSDeviceName OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the name of switch."
        ::= { esSingleIpCaSEntry 2 }

    esSingleIpCaSOperate OBJECT-TYPE
        SYNTAX  INTEGER {
                    noOp(1),
                    transformToMS(2)
                }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object is used to control entry state.
             It will transform to MS table when set to 'transformToMS'.
             No action is taken if this object is set to 'noOp'.
             When read, the value 'noOp' is returned."
        ::= { esSingleIpCaSEntry 3 }

    esSingleIpCaSFirmwareVer OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the firmware version of the switch."
        ::= { esSingleIpCaSEntry 4 }

    esSingleIpCaSCapability OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the capability of the switch."
        ::= { esSingleIpCaSEntry 5 }

    esSingleIpCaSPlatform OBJECT-TYPE
        SYNTAX   DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the platform of the switch."
        ::= { esSingleIpCaSEntry 6 }

    esSingleIpCaSHoldtime OBJECT-TYPE
        SYNTAX  Integer32
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the holdtime of the Single IP Management protocol
             sent by this candidate switch."
        ::= { esSingleIpCaSEntry 7 }

    esSingleIpCasPassword OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..16))
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "Specifies the CaS password when creating the MS entry. The object is used
            only when creating the esSingleIpCaSEntry. The value always shows a zero length string."
        ::= { esSingleIpCaSEntry 8 }     
        
    esSingleIpCaSCfgStatus OBJECT-TYPE
        SYNTAX  INTEGER {
                    normal(1),
                    waiting(2)
                }
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the config ACK status of this device. 
            allow: device can send a config packet
            not-allow: device still wait for config ACK."
        ::= { esSingleIpCaSEntry 9 }

-- -----------------------------------------------------------------------------
-- esSingleIpGroupTable
-- -----------------------------------------------------------------------------
    esSingleIpGroupTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF EsSingleIpGroupEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This table contains information about Single IP Management groups learned by the
             commander switch.
             This table is a read-only table listing all information about the Single IP groups that will
             maintained automatically by Single IP topology discovery protocol."
        ::= { esSingleIpMgmt 5 }

    esSingleIpGroupEntry OBJECT-TYPE
        SYNTAX  EsSingleIpGroupEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "A list of information about Single IP Management groups."
        INDEX  { esSingleIpGroupMacAddr }
        ::= { esSingleIpGroupTable 1 }

    EsSingleIpGroupEntry ::=
        SEQUENCE {
            esSingleIpGroupMacAddr          MacAddress,
            esSingleIpGroupName             DisplayString,
            esSingleIpGroupDeviceName       DisplayString,
            esSingleIpGroupMSNumber         Integer32,
            esSingleIpGroupFirmwareVer      DisplayString,
            esSingleIpGroupCapability       DisplayString,
            esSingleIpGroupPlatform         DisplayString,
            esSingleIpGroupHoldtime         Integer32
        }

    esSingleIpGroupMacAddr OBJECT-TYPE
        SYNTAX  MacAddress
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This object specifies the MAC address of the commander switch."
        ::= { esSingleIpGroupEntry 1 }

    esSingleIpGroupName OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the name of the Single IP Management group."
        ::= { esSingleIpGroupEntry 2 }

    esSingleIpGroupDeviceName OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the name of commander switch of the group."
        ::= { esSingleIpGroupEntry 3 }

    esSingleIpGroupMSNumber OBJECT-TYPE
        SYNTAX  Integer32
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the member switch number of the group.
             "
        ::= { esSingleIpGroupEntry 4 }

    esSingleIpGroupFirmwareVer OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the firmware version of the switch."
        ::= { esSingleIpGroupEntry 5 }

    esSingleIpGroupCapability OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the capability of the switch."
        ::= { esSingleIpGroupEntry 6 }

    esSingleIpGroupPlatform OBJECT-TYPE
        SYNTAX   DisplayString (SIZE (0..64))
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the platform of the switch."
        ::= { esSingleIpGroupEntry 7 }

    esSingleIpGroupHoldtime OBJECT-TYPE
        SYNTAX  Integer32
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Specifies the holdtime of the Single IP Management protocol sent by this commander
             switch."
        ::= { esSingleIpGroupEntry 8 }

-- -----------------------------------------------------------------------------
-- esSingleIpNeighborTable
-- -----------------------------------------------------------------------------
    esSingleIpNeighborTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF EsSingleIpNeighborEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This table contains information about Single IP Management neighbors learned by the
             switch.
             This table is a read-only table listing all the information about Single IP neighbors
             that will be maintained automatically by the Single IP topology protocol."
        ::= { esSingleIpMgmt 6 }

    esSingleIpNeighborEntry OBJECT-TYPE
        SYNTAX  EsSingleIpNeighborEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "A list of information about Single IP Management neighbors."
        INDEX  { esSingleIpNBReceivedPort,esSingleIpNBMacAddr }
        ::= { esSingleIpNeighborTable 1 }

    EsSingleIpNeighborEntry ::=
        SEQUENCE {
            esSingleIpNBReceivedPort    Integer32,
            esSingleIpNBMacAddr         MacAddress,
            esSingleIpNBRoleState       INTEGER
        }

    esSingleIpNBReceivedPort OBJECT-TYPE
        SYNTAX  Integer32 (1..2147483647)
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "Specifies the received port of the neighbor switch."
        ::= { esSingleIpNeighborEntry 1 }

    esSingleIpNBMacAddr OBJECT-TYPE
        SYNTAX  MacAddress
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "This object specifies the MAC address of the neighbor switch."
        ::= { esSingleIpNeighborEntry 2 }

    esSingleIpNBRoleState OBJECT-TYPE
        SYNTAX  INTEGER {
                    commander(1),
                    candidate(2),
                    member(3)
                }
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object specifies the role state of the neighbor switch."
        ::= { esSingleIpNeighborEntry 3 }

