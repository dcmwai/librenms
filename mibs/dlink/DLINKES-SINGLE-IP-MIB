            esSingleIpVersion,
            esSingleIpCapability,
            esSingleIpPlatform,
            esSingleIpFirmwareVer,
            esSingleIpDeviceName,
            esSingleIpMacAddr
        }
        STATUS current
        DESCRIPTION
            "."
        ::= { esSingleIpMIBGroups 1 }

