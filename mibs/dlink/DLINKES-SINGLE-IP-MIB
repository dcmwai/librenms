            esSingleIpCSGroupName,
            esSingleIpMgmtVlan,
            esSingleIpTrapStatus
        }
        STATUS current
        DESCRIPTION
            "."
        ::= { esSingleIpMIBGroups 2 }

    esSingleIpMSGroup OBJECT-GROUP
        OBJECTS {
            esSingleIpMSDeviceName,
            esSingleIpMSOperate,
            esSingleIpMSFirmwareVer,
            esSingleIpMSCapability,
            esSingleIpMSPlatform,
            esSingleIpMSHoldtime
        }
        STATUS current
        DESCRIPTION
            "."
        ::= { esSingleIpMIBGroups 3 }

