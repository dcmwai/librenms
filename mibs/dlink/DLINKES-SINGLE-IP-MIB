    esSingleIpMIBCompliances    OBJECT IDENTIFIER ::= { esSingleIpConformance 1 }
    esSingleIpMIBGroups         OBJECT IDENTIFIER ::= { esSingleIpConformance 2 }

    esSingleIpMIBCompliance MODULE-COMPLIANCE
        STATUS  current
        DESCRIPTION
            "The compliance statement for DLINKES-SINGLE-IP-MIB"
        MODULE
        MANDATORY-GROUPS {
            esSingleIpInfoGroup,
            esSingleIpCtrlGroup,
            esSingleIpBindGroup
        }

        GROUP esSingleIpMSGroup
        DESCRIPTION
            "."

        GROUP esSingleIpCaSGroup
        DESCRIPTION
            "."

        GROUP esSingleIpGroupGroup
        DESCRIPTION
            "."

        GROUP esSingleIpNeighborGroup
        DESCRIPTION
            "."

        GROUP esSingleIpNotifyGroup
        DESCRIPTION
            "."

        ::= { esSingleIpMIBCompliances 1 }

