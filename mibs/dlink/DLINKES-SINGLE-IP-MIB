        OBJECTS {
            esSingleIpCaSDeviceName,
            esSingleIpCaSOperate,
            esSingleIpCaSFirmwareVer,
            esSingleIpCaSCapability,
            esSingleIpCaSPlatform,
            esSingleIpCaSHoldtime,
            esSingleIpCasPassword
        }
        STATUS current
        DESCRIPTION
            "."
        ::= { esSingleIpMIBGroups 4 }

    esSingleIpGroupGroup OBJECT-GROUP
