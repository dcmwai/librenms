             esDdmIfInfoCurrentTemperature, esDdmIfInfoTemperatureState,
             esDdmIfInfoHighAlarmTemperature, esDdmIfInfoHighWarnTemperature,              
             esDdmIfInfoLowWarnTemperature, esDdmIfInfoLowAlarmTemperature,              
             esDdmIfInfoCurrentVoltage, esDdmIfInfoVoltageState,        
