-- -----------------------------------------------------------------------------
    esIfCounterIfLinkChangeTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIfCounterIfLinkChangeEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION           
            "This table is used to display the number of interface link 
            change events."
        ::= { esIfCounterGernal 1}    

    esIfCounterIfLinkChangeEntry OBJECT-TYPE
        SYNTAX          EsIfCounterIfLinkChangeEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Entry containing the number of interface link change events for a 
            particular interface."
        INDEX                 { ifIndex }
        ::= { esIfCounterIfLinkChangeTable 1 }
        
    EsIfCounterIfLinkChangeEntry ::= SEQUENCE     	{
    	esIfCounterIfLinkChange        Counter64
    }
    
    esIfCounterIfLinkChange OBJECT-TYPE 
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The number of interface link change events."
        ::= { esIfCounterIfLinkChangeEntry 1 } 
  
-- -----------------------------------------------------------------------------
    esIfCounterIfUtilizationTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIfCounterIfUtilizationEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION           
            "This table is used to display the utilization of ports."
        ::= { esIfCounterGernal 2}    

    esIfCounterIfUtilizationEntry OBJECT-TYPE
        SYNTAX          EsIfCounterIfUtilizationEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "Entry contains the utilization information of a port."
        INDEX                 { ifIndex }
        ::= { esIfCounterIfUtilizationTable 1 }
        
    EsIfCounterIfUtilizationEntry ::= SEQUENCE     	{
        esIfCounterIfUtilizationRx        Unsigned32,
    	esIfCounterIfUtilizationTx        Unsigned32,
    	esIfCounterIfUtilizationUtil      Unsigned32
    }

    esIfCounterIfUtilizationRx OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "packets per second"
        MAX-ACCESS      read-only
        STATUS          deprecated
        DESCRIPTION
            "This object indicates the current rate of received frames on the interface.
	        This object is deprecated in favour of esIfCounterRateStatsRxPkts."
        ::= { esIfCounterIfUtilizationEntry 1 }
            
    esIfCounterIfUtilizationTx OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "packets per second"
        MAX-ACCESS      read-only
        STATUS          deprecated
        DESCRIPTION
            "This object indicates the current rate of transmitted frames on the interface.
	         This object is deprecated in favour of esIfCounterRateStatsTxPkts."
        ::= { esIfCounterIfUtilizationEntry 2 }
        
    esIfCounterIfUtilizationUtil OBJECT-TYPE
        SYNTAX          Unsigned32 (0..100)
        UNITS           "percentage"
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the percentage of the utilization on the
            interface."
        ::= { esIfCounterIfUtilizationEntry 3 }  
                              

-- -----------------------------------------------------------------------------
    esIfCounterClearAll  OBJECT-TYPE
        SYNTAX        INTEGER     {
            clear(1),
            noOp(2)
            }
        MAX-ACCESS    read-write
        STATUS        current
        DESCRIPTION
            "This object clears all counters, when set to 'clear'. 
            No action is taken if this object is set to 'noOp'.
            When read, the value 'noOp' is returned."
        ::= { esIfCounterClearCtrl 1}
       
    esIfCounterClearIf OBJECT-TYPE 
        SYNTAX          InterfaceIndexOrZero
        MAX-ACCESS	    read-write
        STATUS		    current
        DESCRIPTION
            "This object indicates the ifIndex of the physical 
            port interface on which the counters will be cleared.            
            When read, a value of 0 is returned."   
        ::= { esIfCounterClearCtrl 2 } 
 
-- -----------------------------------------------------------------------------
    esIfRxStatsTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIfRxStatsEntry
        MAX-ACCESS      not-accessible
        STATUS          current 
        DESCRIPTION           
            "This table is used to display the receiving statistics 
            not covered in standard MIBs (IF-MIB, 
            RMON, BRIDGE-MIB, Etherlike-MIB) or extend the standard defined 
            objects to 64 bits."
        ::= { esIfCounterRxStatistics 1}    

    esIfRxStatsEntry OBJECT-TYPE
        SYNTAX           EsIfRxStatsEntry
        MAX-ACCESS       not-accessible
        STATUS           current
        DESCRIPTION
            "An entry contains receiving statistics on an interface."
        INDEX                 { ifIndex }
        ::= { esIfRxStatsTable 1 }
        
    EsIfRxStatsEntry ::= SEQUENCE     	{
    	esIfRxStatsHCPkts                    Counter64,
    	esIfRxStatsHCPkts64Octets            Counter64,
    	esIfRxStatsHCPkts65to127Octets       Counter64,
    	esIfRxStatsHCPkts128to255Octets      Counter64,
    	esIfRxStatsHCPkts256to511Octets      Counter64,
    	esIfRxStatsHCPkts512to1023Octets     Counter64,
    	esIfRxStatsHCPkts1024to1518Octets    Counter64,
    	esIfRxStatsHCPkts1519to1522Octets    Counter64,
    	esIfRxStatsHCPkts1519to2047Octets    Counter64,
    	esIfRxStatsHCPkts2048to4095Octets    Counter64,
    	esIfRxStatsHCPkts4096to9216Octets    Counter64
    }

    esIfRxStatsHCPkts OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The number of packets received on the interface.  
            This object is a 64-bit version of etherStatsPkts.

            Discontinuities in the value of this counter can occur at
            re-initialization of the management system, and at other
            times as indicated by the value of
            ifCounterDiscontinuityTime."
        ::= { esIfRxStatsEntry 1 } 

    esIfRxStatsHCPkts64Octets OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets (including bad packets)
            received that were 64 octets in length (excluding 
            framing bits but including FCS octets).
            This object is a 64-bit version of etherStatsPkts64Octets.
           
            Discontinuities in the value of this counter can occur at
            re-initialization of the management system, and at other
            times as indicated by the value of
            ifCounterDiscontinuityTime."           
        ::= { esIfRxStatsEntry 2 } 

    esIfRxStatsHCPkts65to127Octets OBJECT-TYPE
