            "A list of entries for counting the received or transmitted
            packets bytes at VLAN level and displays the statistics.
            The 'ifIndex' represent layer 2 VLAN interface index and
            the 'esIfCounterL2VlanPortIndex' represent physical port interface index.
            The physical port interface index should be zero for VLAN-based counting."
        INDEX   { esIfCounterL2VlanDirection,ifIndex,esIfCounterL2VlanPortIndex,esIfCounterL2VlanPktType }
        ::= { esIfCounterL2VlanTable 1 }

    EsIfCounterL2VlanEntry ::=
        SEQUENCE {
            esIfCounterL2VlanDirection
                INTEGER,
            esIfCounterL2VlanPortIndex
                 InterfaceIndexOrZero,            
            esIfCounterL2VlanPktType
                 INTEGER,                        
