    	::= { esIfCounterRxDropEntry 9 }

    esIfCounterRxBandwidthCtrlDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets discarded by port ingress bandwidth 
            control."
    	::= { esIfCounterRxDropEntry 10 }

