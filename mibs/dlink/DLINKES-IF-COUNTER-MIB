 esIfHistoryCntRxErrorTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIfHistoryCntRxErrorEntry 
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table consists of a list of receiving historical statistics for error 
            packets on interfaces during an specified historical time range."
        ::= { esIfCounterHistoryStatistics 2 }

    esIfHistoryCntRxErrorEntry OBJECT-TYPE
        SYNTAX          EsIfHistoryCntRxErrorEntry 
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry contains the receiving statistics  for error packets on 
            an interface during a specified historical time range."
        INDEX   { ifIndex,esIfHistoryCntType,esIfHistoryCntSlot }
		
        ::= { esIfHistoryCntRxErrorTable 1 }

    EsIfHistoryCntRxErrorEntry ::= SEQUENCE     	{
		esIfHistoryCntRxCRCErrorPkts 	            Counter64,
		esIfHistoryCntRxUndersizePkts                Counter64,
		esIfHistoryCntRxOversizePkts           		Counter64,
		esIfHistoryCntRxFragment            			Counter64,
		esIfHistoryCntRxJabberPkts                	Counter64,
		esIfHistoryCntRxCodeErrors                   Counter64,
		esIfHistoryCntRxFalseCarrie       			Counter64,
		esIfHistoryCntRxAlignmentErrorsPkts          Counter64,
		esIfHistoryCntRxErrStartTime					DateAndTime,
		esIfHistoryCntRxErrEndTime		            DateAndTime 
   	}

    esIfHistoryCntRxCRCErrorPkts OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates receiving total  historical number of CRC(FCS)Error packets during
			a specified historical time range.	The CRC Error packets that are an integral number of octets
			in length but do not pass the FCS check.This count does not include frames received 
			with frame-too-long or frame-too-short error."
    	::= { esIfHistoryCntRxErrorEntry 1 }
		
	esIfHistoryCntRxUndersizePkts OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
           "The receiving total historical number of Undersize packets during a specified historical
		   time range.The Undersize packets were less than 64 octets long (excluding framing bits but 
		   including FCS octets) and were otherwise well formed."
    	::= { esIfHistoryCntRxErrorEntry 2 }
		
	esIfHistoryCntRxOversizePkts OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The receiving total historical number of Oversize packets during a specified historical
			time range.The Oversize packets were longer than 1518 octets (excluding framing bits but
			including FCS octets) but were otherwise well formed."
    	::= { esIfHistoryCntRxErrorEntry 3 }
		
	esIfHistoryCntRxFragment OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The receiving total historical number of Fragment packets during a specified historical 
			time range.The Fragment packets were less than 64 octets in length(excluding framing bits 
			but including FCS octets) and had either a bad Frame Check Sequence(FCS) with an integral
			number of octets (FCS Error) or a bad FCS with a non-integral number of octets(Alignment Error)"
    	::= { esIfHistoryCntRxErrorEntry 4 }
		
	esIfHistoryCntRxJabberPkts OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The receiving total historical number  of Jabber packets during a specified historical 
			time range.The Jabber packets were longer than 1518 octets (excluding framing bits,
			but including FCS octets),and had either a bad Frame Check Sequence (FCS)with an integral 
			number of octets (FCS Error) or a bad FCS with a non-integral number of octets (Alignment Error)."
    	::= { esIfHistoryCntRxErrorEntry 5 }
		
	esIfHistoryCntRxCodeErrors OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The receiving total historical number of times where there was an invalid data symbol
			when a valid carrier was present during a specified historical time range."
    	::= { esIfHistoryCntRxErrorEntry 6 }
		
	esIfHistoryCntRxFalseCarrie OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The receiving total historical number of times where the carrier sense	condition 
			was lost or never asserted when attempting to transmit a frame on a particular
			interface during  a specified historical time range."
    	::= { esIfHistoryCntRxErrorEntry 7 }
		
	esIfHistoryCntRxAlignmentErrorsPkts OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The receiving total historical number of Alignment Errors packets during 
			a specified historical time range.The Alignment Errors packets that are not an 
			integral number of octets in length and do not pass the FCS check."
    	::= { esIfHistoryCntRxErrorEntry 8 }
		
	esIfHistoryCntRxErrStartTime OBJECT-TYPE
        SYNTAX          DateAndTime
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
          "This object indicates the start time of the specified slot."
        ::= { esIfHistoryCntRxErrorEntry 9 } 
		
	esIfHistoryCntRxErrEndTime OBJECT-TYPE
        SYNTAX          DateAndTime
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
           "This object indicates the end time of the specified slot."
        ::= { esIfHistoryCntRxErrorEntry 10 } 
