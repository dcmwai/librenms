esIfCounterHistoryStatsRxTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIfHistoryStatsRxEntry
        MAX-ACCESS      not-accessible
        STATUS          current 
        DESCRIPTION           
            "This table is used to display the receiving historical statistics 
            not covered in standard MIBs (IF-MIB, 
            RMON, BRIDGE-MIB, Etherlike-MIB) or extend the standard defined 
            objects to 64 bits."
        ::= { esIfCounterHistoryStatistics 1}    

    esIfHistoryStatsRxEntry OBJECT-TYPE
        SYNTAX           EsIfHistoryStatsRxEntry
        MAX-ACCESS       not-accessible
        STATUS           current
        DESCRIPTION
            "An entry contains receiving historical statistics on an interface.
			 The 'ifIndex' just represent physical port index now.
			 the 'esIfHistoryCntType'represent type of historical statistics,including fifteen-minute and one-day.
			 the 'esIfHistoryCntSlot'represent the number of time slot. For fifteen-minute historical counter,
			 the slot number is 1-5,and for one-day's,the slot number is 1-2."
        INDEX          { ifIndex,esIfHistoryCntType,esIfHistoryCntSlot }
        ::= { esIfCounterHistoryStatsRxTable 1 }
        
    EsIfHistoryStatsRxEntry ::= SEQUENCE     	{
		esIfHistoryCntType                   	   INTEGER,
		esIfHistoryCntSlot                      	   INTEGER,
		esIfHistoryRxStatsHCPkts                    Counter64,
		esIfHistoryRxStatsHCBytes                   Counter64,
		esIfHistoryRxStatsHCUnicastPkts             Counter64,
		esIfHistoryRxStatsHCMulticastPkts           Counter64,
		esIfHistoryRxStatsHCBroadcastPkts           Counter64,
		esIfHistoryRxStatsHCPkts64Octets            Counter64,
		esIfHistoryRxStatsHCPkts65to127Octets       Counter64,
		esIfHistoryRxStatsHCPkts128to255Octets      Counter64,
		esIfHistoryRxStatsHCPkts256to511Octets      Counter64,
		esIfHistoryRxStatsHCPkts512to1023Octets     Counter64,
		esIfHistoryRxStatsHCPkts1024to1518Octets    Counter64,
		esIfHistoryRxStatsHCPkts1519to1522Octets    Counter64,
		esIfHistoryRxStatsHCPkts1519to2047Octets    Counter64,
		esIfHistoryRxStatsHCPkts2048to4095Octets    Counter64,
		esIfHistoryRxStatsHCPkts4096to9216Octets    Counter64,
		esIfHistoryRxStatsStartTime                 DateAndTime,
		esIfHistoryRxStatsEndTime                   DateAndTime		 
    }
		
	esIfHistoryCntType OBJECT-TYPE
        SYNTAX  INTEGER{
			fifteen-minute(1),
			one-day(2)
                }
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the time slot for counters."
        ::= { esIfHistoryStatsRxEntry 1 } 
		
	esIfHistoryCntSlot OBJECT-TYPE
        SYNTAX          INTEGER (1..10)
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the type of time slot for counters.
            e.g.         
           		when swHistoryCntTime is equal to fifteen-minute(1):
           			1: indicates slot 1(relate to the previous  0 ~ 15 minutes)
           			2: indicates slot 2(relate to the previous 15 ~ 30 minutes)
           			3: indicates slot 3(relate to the previous 30 ~ 45 minutes)
           			... 
           			n: indicates slot n(relate to the previous (n-1)*15 ~ n*15 minutes)

            	when swHistoryCntTime is equal to one-day(2):
            		1: indicates slot 1(relate to the previous  0 ~ 24 hours)
            		2: indicates slot 2(relate to the previous 24 ~ 48 hours)
            		3: indicates slot 3(relate to the previous 48 ~ 72 hours)
            		...
            		m: indicates slot m(relate to the previous (m-1)*24 ~ m*24 hours)
            		
           		For each case, one or more historical statistic entries can be supported, the
           	    maximum	slot number is project depended."
        ::= { esIfHistoryStatsRxEntry 2 } 
		
