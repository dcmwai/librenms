-- -----------------------------------------------------------------------------
    esIfCounterRxDropTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIfCounterRxDropEntry 
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table consists of a list of receiving statistics for discarded 
            packets on interfaces."
        ::= { esIfCounterRxStatistics 2 }

    esIfCounterRxDropEntry OBJECT-TYPE
        SYNTAX          EsIfCounterRxDropEntry 
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry contains the receiving statistics for discarded packets on 
            an interface."
        INDEX   { ifIndex }
        ::= { esIfCounterRxDropTable 1 }

    EsIfCounterRxDropEntry ::= SEQUENCE     	{
        esIfCounterRxBufferFullDrops	            Counter64,
        esIfCounterRxACLDrops                    Counter64,
        esIfCounterRxMulticastDrops              Counter64,
        esIfCounterRxVLANIngressDrops            Counter64,
        esIfCounterRxIPv6Drops                   Counter64,
        esIfCounterRxSTPDrops                    Counter64,
        esIfCounterRxStormAndTableDiscard        Counter64,
        esIfCounterRxMTUDrops                    Counter64,
        esIfCounterRxInvalidDestPort             Counter64,   
        esIfCounterRxBandwidthCtrlDrops          Counter64
   	}

    esIfCounterRxBufferFullDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets discarded while input buffer full."
    	::= { esIfCounterRxDropEntry 1 }

    esIfCounterRxACLDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of received packets denied by ACLs."
    	::= { esIfCounterRxDropEntry 2 }

    esIfCounterRxMulticastDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of received multicast packet that is discarded."
    	::= { esIfCounterRxDropEntry 3 }

    esIfCounterRxVLANIngressDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets discarded by VLAN ingress checking."
    	::= { esIfCounterRxDropEntry 4 }    	

    esIfCounterRxIPv6Drops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of IPv6 packets dropped by routing process."
    	::= { esIfCounterRxDropEntry 5 }

    esIfCounterRxSTPDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets discarded when ingress 
             port is not in forwarding state."
    	::= { esIfCounterRxDropEntry 6 }

    esIfCounterRxStormAndTableDiscard OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets discarded by receiving policy
            (e.g. the source or destination MAC is not allowed, rate limit, etc.)"
    	::= { esIfCounterRxDropEntry 7 }

    esIfCounterRxMTUDrops OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets discarded by frames received, which 
            exceeds Maximum Frame in length and contains a valid or invalid FCS."
    	::= { esIfCounterRxDropEntry 8 }

    esIfCounterRxInvalidDestPort OBJECT-TYPE
        SYNTAX          Counter64
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "The total number of packets dropped due to no destination port can
