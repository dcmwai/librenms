--  compliance statements

    esIfCounterCompliance MODULE-COMPLIANCE
        STATUS         current
        DESCRIPTION
            "The compliance statement for entities which implement the
            DLINKES-IF-COUNTER-MIB."

        MODULE  -- this module
        MANDATORY-GROUPS 
            { 
            	esIfCounterUtilizationGroup,
            	esIfCounterClearCtrlGroup,
            	esIfCounterHCStatsGroup
            }

        GROUP esIfCounterIfLinkChangeGroup
            DESCRIPTION
                "This group is mandatory for those devices support counting
                the number of link change events."

        GROUP esIfCounterDropStatsGroup
            DESCRIPTION
                "This group is mandatory for those devices support statistics
                information dropped by specified interface."
 
         GROUP esIfCounterL2VlanGroup
            DESCRIPTION
                "This group is mandatory for those devices support layer 2 VLAN statistics
                which use ACL resources." 
		
        GROUP  esIfCounterRateStatsGroup  
		    DESCRIPTION
			    "This group is mandatory for those devices support rate statistics
                on specified interfaces."
				
		GROUP esIfCounterHistoryHCStatsGroup
            DESCRIPTION
                "This group is mandatory for those devices support historical statistics
                information on specified interface."
		
		GROUP esIfCounterHistoryErrorStatsGroup
            DESCRIPTION
                "This group is mandatory for those devices support historical Error statistics
                information on specified interface."
				
        GROUP esIfCounterHistoryDropStatsGroup
            DESCRIPTION
                "This group is mandatory for those devices support historical discarded statistics
                information on specified interface."
 				
        ::= { esIfCounterCompliances 1 }
		
		
