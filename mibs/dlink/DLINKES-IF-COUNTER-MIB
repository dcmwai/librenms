            esIfCounterL2VlanBytesStatstics
                Counter64,
            esIfCounterL2VlanRowStatus
                RowStatus
                 }
                 
     esIfCounterL2VlanDirection OBJECT-TYPE
        SYNTAX INTEGER {
               rx(1),
               tx(2),
               both(3)
               }
        MAX-ACCESS  read-only
