DLINKES-IF-COUNTER-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        MODULE-IDENTITY,
        OBJECT-TYPE,
        Unsigned32,
        Counter64
            FROM SNMPv2-SMI
        MODULE-COMPLIANCE, 
        OBJECT-GROUP
            FROM SNMPv2-CONF
        RowStatus,
		DateAndTime        
            FROM SNMPv2-TC
        ifIndex,
        InterfaceIndexOrZero         
            FROM IF-MIB
        dlinkCommon
            FROM DLINK-ID-REC-MIB;

    dlinkEsIfCounterMIB MODULE-IDENTITY
        LAST-UPDATED "201509060000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "        D-Link Corporation

             Postal: No. 289, Sinhu 3rd Rd., Neihu District,
                     Taipei City 114, Taiwan, R.O.C
             Tel:     +886-2-66000123
             E-mail: tsd@dlink.com.tw
            "
        DESCRIPTION
            "This MIB module defines objects for displaying counters."

        REVISION "201302050000Z"
        DESCRIPTION
            "This is the first version of the MIB file."
			
        REVISION "201406240000Z"
        DESCRIPTION
            "Add esifCounterL2VlanStatisticsCtrl for layer 2 VLAN interface
            statistics which use ACL resources."
        REVISION "201503160000Z"  
        DESCRIPTION
            "Add esIfCounterRateStatistics for displaying packets and bits rate ."				
      
		REVISION "201506230000Z"  
        DESCRIPTION
            "Add esIfCounterHistoryStatistics for displaying history counters.
			Add esIfCounterHistoryUtilization for displaying history switch utilization of cpu and memory."
		
		REVISION "201509030000Z"  
        DESCRIPTION
			"Delete esIfCounterHistoryUtilization for displaying history switch utilization of cpu and memory."				
        ::= { dlinkCommon 66 }

-- -----------------------------------------------------------------------------
    esIfCounterNotifications    OBJECT IDENTIFIER ::= { dlinkEsIfCounterMIB 0 }
    esIfCounterObjects          OBJECT IDENTIFIER ::= { dlinkEsIfCounterMIB 1 }
    esIfCounterConformance      OBJECT IDENTIFIER ::= { dlinkEsIfCounterMIB 2 }


-- -----------------------------------------------------------------------------
