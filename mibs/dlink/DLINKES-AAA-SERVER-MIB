    esasMIBCompliances  OBJECT IDENTIFIER ::= { esAaaSrvMIBConformance 1 }

-- compliance statements

    esasMIBCompliance MODULE-COMPLIANCE
        STATUS          current
        DESCRIPTION
            "The compliance statement for entities which implement the
            DLINKES-AAA-SERVER-MIB."
        MODULE      -- this module
        MANDATORY-GROUPS    {
            esasConfigGroup,
            esasTacplusStatisticsGroup
        }

        GROUP esasSrvGroupGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            AAA server group configuration.
            "

        GROUP esasVrfGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            AAA VRF configuration.
            "

        GROUP esasSrcIfGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            AAA source interface configuration.
            "

        GROUP esasClearStatGroup
        DESCRIPTION
            "This group is mandatory only for the platform which supports
            clear server statistics.
            "

        OBJECT      esasServerAddrType
        MIN-ACCESS  read-only
        DESCRIPTION
            "Write access is not required after server entry created."

        OBJECT      esasServerAddress
        MIN-ACCESS  read-only
        DESCRIPTION
            "Write access is not required after server entry created."

        OBJECT      esasServerKey
        MIN-ACCESS  read-only
        DESCRIPTION
            "The maximum length of RADIUS server host is 32 characters.
            The maximum length of TACACS+ server host 254 characters.
            When read, a zero length string will be returned for security reasons."

        ::= { esasMIBCompliances  1 }


-- units of conformance

    esasMIBGroups       OBJECT IDENTIFIER ::= { esAaaSrvMIBConformance 2 }

    esasTacplusStatisticsGroup OBJECT-GROUP
        OBJECTS {
            esasTacplusSocketOpens,
            esasTacplusSocketCloses,
            esasTacplusTotalPktSent,
            esasTacplusTotalPktRecv,
            esasTacplusReferenceCount
        }
        STATUS          current
        DESCRIPTION
            "Objects for providing AAA tacacs+ server statistics and status.
            "
        ::= { esasMIBGroups 1 }

    esasConfigGroup OBJECT-GROUP
        OBJECTS {
            esasRadiusServerDeadTime,
            esasRadiusServerAttr4Address,
            esasServerAddrType,
            esasServerAddress,
            esasServerAuthenPort,
            esasServerAcctPort,            
            esasServerTimeout,
            esasServerRetransmit,
            esasServerKey,
            esasServerPriority,
            esasServerRowStatus
        }
        STATUS          current
        DESCRIPTION
            "Objects for configuring the AAA servers.
            "
        ::= { esasMIBGroups 2 }

    esasSrvGroupGroup OBJECT-GROUP
        OBJECTS {
            esasGroupRowStatus,
            esasGroupSrvAddrType,
            esasGroupSrvAddress,
            esasGroupSrvPriority,
            esasGroupServerRowStatus
        }
        STATUS          current
        DESCRIPTION
            "Objects for configuring the AAA server groups.
            "
        ::= { esasMIBGroups 3 }

    esasVrfGroup OBJECT-GROUP
        OBJECTS {
            esasGroupVrfName,
            esasGroupVrfConfigRowStatus
        }
        STATUS      current
        DESCRIPTION
            "Objects for configuring the AAA VRF setting.
            "
        ::= { esasMIBGroups 4 }

    esasSrcIfGroup OBJECT-GROUP
        OBJECTS {                
            esasGroupSrcIfIndex,
            esasGroupSrcIfConfigRowStatus
        }
        STATUS      current
        DESCRIPTION
            "Objects for configuring the AAA source interface setting.
            "
        ::= { esasMIBGroups 5 }

    esasClearStatGroup OBJECT-GROUP
        OBJECTS {
            esasClearServerStatAction,
            esasClearServerStatByGroup,
            esasClearServerStatByProtocol,
            esasClearAllServerStat
        }
        STATUS      current
        DESCRIPTION
            "Objects for clear the AAA server statistics.
            "
        ::= { esasMIBGroups 6 }

END


