    esDhcpServerCompliance MODULE-COMPLIANCE
        STATUS current
        DESCRIPTION 
            "The compliance statement for entities which implement the 
             DLINKES-DHCP-SERVER-MIB."
        MODULE -- this module
        MANDATORY-GROUPS { 
             esDhcpSGblCfgGroup, 
             esDhcpSClassGroup, 
             esDhcpSClassCfgGroup,
             esDhcpSPoolGroup,
             esDhcpSPoolCfgGroup,
             esDhcpSPoolNetworkCfgGroup,
             esDhcpSPoolManualBindingGroup,
             esDhcpSStatisticsGroup,
             esDhcpSGeneralInfoGroup
        }
 
        OBJECT          esDhcpSPoolCfgVrfName
        MIN-ACCESS      read-only
        DESCRIPTION
           "Create/Write access is required only if the agent supports virtual
            routing and forwarding(VRF)."
        ::= { esDhcpServerCompliances 1 }
 
