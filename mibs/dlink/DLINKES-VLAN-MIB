DLINKES-VLAN-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        MODULE-IDENTITY,
        OBJECT-TYPE,
        NOTIFICATION-TYPE,        
        Unsigned32
            FROM SNMPv2-SMI
        RowStatus,TruthValue,MacAddress   
            FROM SNMPv2-TC
        MODULE-COMPLIANCE, OBJECT-GROUP
            FROM SNMPv2-CONF
        InetAddress, InetAddressType, InetAddressPrefixLength    
            FROM INET-ADDRESS-MIB
        dot1dBasePort
            FROM BRIDGE-MIB
        VlanId,dot1vProtocolPortGroupId                         
            FROM Q-BRIDGE-MIB  
        Dlink2kVlanList                 
            FROM DLINKES-TC-MIB  
        dlinkCommon                     
            FROM DLINK-ID-REC-MIB;              

                                       
    dlinkEsVlanMIB MODULE-IDENTITY
        LAST-UPDATED "201401020000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "        D-Link Corporation

             Postal: No. 289, Sinhu 3rd Rd., Neihu District,
                     Taipei City 114, Taiwan, R.O.C
             Tel:     +886-2-66000123
             E-mail: tsd@dlink.com.tw
            "
        DESCRIPTION
            "This MIB module defines objects for extending the configuration of 
            VLAN (Virtual Local Area Network). "

        REVISION "201401020000Z"
        DESCRIPTION
            "Add new port mode privateVlanTrunkPromiscuous and privateVlanTrunkSecondary
            for private VLAN."
            
        REVISION "201304180000Z"
        DESCRIPTION
            "This is the first version of the MIB file."

        ::= { dlinkCommon 21 } 
            
-- -----------------------------------------------------------------------------
    esVlanMIBNotifications   OBJECT IDENTIFIER ::= { dlinkEsVlanMIB 0 }
    esVlanMIBObjects         OBJECT IDENTIFIER ::= { dlinkEsVlanMIB 1 }
    esVlanMIBConformance     OBJECT IDENTIFIER ::= { dlinkEsVlanMIB 2 }

-- -----------------------------------------------------------------------------    
    esVlanStaticMacVlanTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsVlanStaticMacVlanEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table contains a list of MAC-based VLANs."
        ::= { esVlanMIBObjects 1 }

    esVlanStaticMacVlanEntry OBJECT-TYPE
        SYNTAX          EsVlanStaticMacVlanEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table entry represents the configuration of a MAC-based VLAN."
        INDEX    { esVlanStaticMacVlanAddress }
        ::= { esVlanStaticMacVlanTable 1 }

    EsVlanStaticMacVlanEntry ::= SEQUENCE {
        esVlanStaticMacVlanAddress     MacAddress,
        esVlanStaticMacVlanId          VlanId,
        esVlanStaticMacVlanPriority    Unsigned32,
        esVlanStaticMacVlanRowStatus   RowStatus    
    }
                 
    esVlanStaticMacVlanAddress OBJECT-TYPE
        SYNTAX          MacAddress
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This object indicates the MAC address of the entry."
        ::= { esVlanStaticMacVlanEntry 1 }
        
    esVlanStaticMacVlanId OBJECT-TYPE
        SYNTAX          VlanId
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the Vlan ID for the MAC based VLAN entry."
        ::= { esVlanStaticMacVlanEntry 2 }
        
    esVlanStaticMacVlanPriority OBJECT-TYPE
        SYNTAX          Unsigned32 ( 0 .. 7 )
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the CoS for the MAC based VLAN entry."
        DEFVAL { 0 }
        ::= { esVlanStaticMacVlanEntry 3 }

    esVlanStaticMacVlanRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The status of this conceptual row."
        ::= { esVlanStaticMacVlanEntry 4 } 
 
-- -----------------------------------------------------------------------------
esVlanCurrentMacVlanTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsVlanCurrentMacVlanEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This table contains a list of MAC-based VLANs."
        ::= { esVlanMIBObjects 2 }

    esVlanCurrentMacVlanEntry OBJECT-TYPE
        SYNTAX          EsVlanCurrentMacVlanEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table entry represents the information of a MAC-based VLAN."
        INDEX    { 
            esVlanCurrentMacVlanAddress,
            esVlanCurrentMacVlanStatus
        }
        ::= { esVlanCurrentMacVlanTable 1 }

    EsVlanCurrentMacVlanEntry ::= SEQUENCE {
        esVlanCurrentMacVlanAddress     MacAddress,
        esVlanCurrentMacVlanStatus      INTEGER,
        esVlanCurrentMacVlanId          VlanId,
        esVlanCurrentMacVlanPriority    Unsigned32
    }
                 
    esVlanCurrentMacVlanAddress OBJECT-TYPE
        SYNTAX          MacAddress
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This object indicates the MAC address of the entry."
        ::= { esVlanCurrentMacVlanEntry 1 }
 
    esVlanCurrentMacVlanStatus OBJECT-TYPE
        SYNTAX          INTEGER {
            active(1),
            inactive(2)         
        }
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "This object indicates the status of the entry."
        ::= { esVlanCurrentMacVlanEntry 2 }
        
    esVlanCurrentMacVlanId OBJECT-TYPE
        SYNTAX          VlanId
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the Vlan ID for the MAC based VLAN entry."
        ::= { esVlanCurrentMacVlanEntry 3 }
        
    esVlanCurrentMacVlanPriority OBJECT-TYPE
        SYNTAX          Unsigned32 ( 0 .. 7 )
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the CoS for the MAC based VLAN entry."
        ::= { esVlanCurrentMacVlanEntry 4 }
