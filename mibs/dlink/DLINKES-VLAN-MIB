--            ::= { esVlanGroups 4 }    
            
    esVlanProtocolVlanCfgGroup OBJECT-GROUP
        OBJECTS {            
            esVlanProtocolVlanPriority            
        }
        STATUS current
        DESCRIPTION 
            "A collection of objects provides the configuration
            of protocol VLAN entrys on interfaces."
            ::= { esVlanGroups 5 }
     
    esVlanAsymmetricVlanCfgGroup OBJECT-GROUP
        OBJECTS { 
            esVlanAsymVlanStateEnabled
        }
        STATUS current
        DESCRIPTION 
            "A collection of objects provides the management of
            asymmetric VLAN feature."
            ::= { esVlanGroups 6 }
END
