     esDhcp6ROptionExUdfMacFormatCase OBJECT-TYPE
        SYNTAX  INTEGER {
               uppercase(1),
               lowercase(2)
               }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the case format of the option18 and option37 MAC address for profile user define.
             It will be used in the object esDhcp6ROption18ExUdfProfileValue and esDhcp6ROption37ExUdfProfileValue.

             uppercase: Using uppercase format, the formatted is: AA-BB-CC-DD-EE-FF.
             lowercase: Using lowercase format, the formatted is: aa-bb-cc-dd-ee-ff."
        ::= { esDhcp6RelayOptionExpertUdfObjects 3 }

     esDhcp6ROptionExUdfMacFormatDelimiter OBJECT-TYPE
        SYNTAX  INTEGER {
               none(1),
               hyphen(2),
               colon(3),
               dot(4)
               }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the delimiter format of option18 and option37 MAC address for profile user define.
             It will be used in the object esDhcp6ROption18ExUdfProfileValue and esDhcp6ROption37ExUdfProfileValue.

             none: Not using any delimiter, the format is: AABBCCDDEEFF
             hyphen: Using '-' as delimiter, the format is: AA-BB-CC-DD-EE-FF
             colon: Using ':' as delimiter, the format is: AA:BB:CC:DD:EE:FF
             dot: Using '.' as delimiter, the format is: AA.BB.CC.DD.EE.FF"
        ::= { esDhcp6RelayOptionExpertUdfObjects 4 }

     esDhcp6ROptionExUdfMacFormatDelimiterNumber OBJECT-TYPE
        SYNTAX  INTEGER {
               oneDelimiterNumber(1),
               twoDelimiterNumber(2),
               fiveDelimiterNumber(3)
               }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object indicates the delimiter number of option18 and option37 MAC address for profile user define.
             It will be used in the object esDhcp6ROption18ExUdfProfileValue and esDhcp6ROption37ExUdfProfileValue.

            oneDelimiterNumber: single delimiter, the format is: AABBCC.DDEEFF
            oneDelimiterNumber: double delimiter, the format is: AABB.CCDD.EEFF
            oneDelimiterNumber: multiple delimiter, the format is: AA.BB.CC.DD.EE.FF
            Note: while esDhcp6ROptionExUdfMacFormatDelimiter is none(1), the delimiter number will not take effect."
        ::= { esDhcp6RelayOptionExpertUdfObjects 5 }

