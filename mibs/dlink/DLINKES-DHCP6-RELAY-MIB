DLINKES-DHCP6-RELAY-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        MODULE-IDENTITY,
        OBJECT-TYPE
                        FROM SNMPv2-SMI
        MODULE-COMPLIANCE, OBJECT-GROUP
                        FROM SNMPv2-CONF
        InterfaceIndex,
        InterfaceIndexOrZero
                        FROM IF-MIB
        TruthValue,
        RowStatus,
        DisplayString,
        TEXTUAL-CONVENTION
                        FROM SNMPv2-TC
        InetAddressIPv6
                        FROM INET-ADDRESS-MIB
        dlinkCommon
                        FROM DLINK-ID-REC-MIB
        Dlink2kVlanList
                        FROM DLINKES-TC-MIB;

    dlinkEsDhcp6RelayMIB MODULE-IDENTITY
        LAST-UPDATED "201702020000Z"
        ORGANIZATION "D-Link Corp."
        CONTACT-INFO
            "         D-Link Corporation
             Postal: No. 289, Sinhu 3rd Rd., Neihu District,
                     Taipei City 114, Taiwan, R.O.C
             Tel:    +886-2-66000123
             E-mail: tsd@dlink.com.tw
            "
        DESCRIPTION
            "This MIB module defines objects for DHCPv6 Relay."

        REVISION    "201702020000Z"
        DESCRIPTION
            "Modify mib object for EESDD."

        REVISION     "201505070000Z"
        DESCRIPTION
            "1.Add the node dDhcp6RInterfaceIdExpertUdfUnitId and dDhcp6RRemoteIdExpertUdfUnitId.
                   2.Add dDhcp6ROption18ExUdfProfileTable,dDhcp6ROption37ExUdfProfileTable, dDhcp6ROptionExUdfMacFormatCase, dDhcp6ROptionExUdfMacFormatDelimiter
               and dDhcp6ROptionExUdfMacFormatDelimiterNumber to support flexible user-defined DHCP option 18 and 37.
                   3.Add dDhcp6RelayVlanObjects to support dhcpv6 local relay.
                   4.Add dDhcp6RPortIfTable to support dhcpv6 relay per port.
                   5.Add dDhcp6RPortIfOption18Table and dDhcp6RPortIfOption37Table to support interface ID and remote ID option for physical port or port channel interface.
                   6.Add new Remote ID type in dDhcp6RRemoteIdFormat: expertUdf(4).
                   7.Add new Interface ID type in dDhcp6RInterfaceIdFormat: expertUdf(4)."

        REVISION     "201407070000Z"
        DESCRIPTION
            "Change the default valude of dDhcp6RInterfaceIdInsertEnabled to true."

        REVISION     "201401090000Z"
        DESCRIPTION
            "Add nodes about Interface ID option"

        REVISION     "201309050000Z"
        DESCRIPTION
            "Add dDhcp6RIfRelayDestOutIfIndex into the dDhcp6RIfRelayDestEntry INDEX"

        REVISION     "201301180000Z"
        DESCRIPTION
            "First release of this MIB."

        ::= { dlinkCommon 88 }

--
-- Textual conventions
--
    RemoteIdType ::= TEXTUAL-CONVENTION
        STATUS current
        DESCRIPTION
            "Represents a remote-id type to determine the content encoded in
            relay agent Remote ID option.
            default(1) - VLAN ID (2 bytes) + Module ID (1 byte) +
                         Port ID (1 byte) + System MAC address (6 bytes)
            cidWithUserDefine(2) - VLAN ID (2 bytes) + Module ID (1 byte) +
                         Port ID (1 byte) + dDhcp6RRemoteIdUdfValue
            userDefine(3) - dDhcp6RRemoteIdUdfValue
            expertUdf(4) - The flexible user defined format
            "

        SYNTAX INTEGER    {
            default(1),
            cidWithUserDefine(2),
            userDefine(3),
            expertUdf(4)
        }

    InterfaceIdType ::= TEXTUAL-CONVENTION
        STATUS current
        DESCRIPTION
            "Represents a interface-id type to determine the content encoded in
            relay agent Interface ID option.
            default(1) - Sub Type(1)+ VLAN ID (2 bytes)
            cid(2) - Sub Type(1)+ VLAN ID (2 bytes) + Module ID (1 byte) +
                         Port ID (1 byte)
            vendor1(3) - Vendor format(HuaWei)
            expertUdf(4) - The flexible user defined format
            "

        SYNTAX INTEGER    {
            default(1),
            cid(2),
            vendor1(3),
            expertUdf(4)
        }

