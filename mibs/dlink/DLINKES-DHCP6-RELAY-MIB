    esDhcp6RelayGeneral          OBJECT IDENTIFIER ::= { esDhcp6RelayMIBObjects 1 }

    esDhcp6RRemoteIdInsertEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates whether the DHCPv6 relay agent inserts relay
            agent Remote ID option (option 37)."
        DEFVAL          { false }
        ::= { esDhcp6RelayGeneral 1 }

    esDhcp6RRemoteIdPolicy OBJECT-TYPE
        SYNTAX          INTEGER { drop(1), keep(2)}
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the re-forwarding policy of DHCPv6 relay agent
             Remote ID (option 37).
             drop (1)    - discards the packet that already has option 37.
             keep (2)    - the DHCP requests packet that already has option 37
                           is left unchanged and directly relayed to the
                           DHCPv6 server."
        DEFVAL          { keep }
        ::= { esDhcp6RelayGeneral 2 }

    esDhcp6RRemoteIdFormat OBJECT-TYPE
        SYNTAX          RemoteIdType
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the encoding type of relay agent remote ID."
        ::= { esDhcp6RelayGeneral 3 }

    esDhcp6RRemoteIdUdfType OBJECT-TYPE
        SYNTAX  INTEGER {
            string(1),
            hex(2)
        }
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the type of esDhcp6RRemoteIdUdfValue.
            string(1): The type of option value is character string.
            hex(2)   : The type of option value is hexadecimal string."
        ::= { esDhcp6RelayGeneral 4 }

    esDhcp6RRemoteIdUdfValue OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates the user defined field which will be used to
            encode the relay agent Remote ID option.
            esDhcp6RRemoteIdUdfValue is always interpreted within the context
            of an esDhcp6RRemoteIdUdfType value."
        ::= { esDhcp6RelayGeneral 5 }

    esDhcp6RInterfaceIdInsertEnabled OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
            "This object indicates whether the DHCPv6 relay agent inserts relay
