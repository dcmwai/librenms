    esDhcp6RelayCompliances OBJECT IDENTIFIER ::= { esDhcp6RelayMIBConformance 1 }

    esDhcp6RelayCompliance MODULE-COMPLIANCE
        STATUS          current
        DESCRIPTION
            "The compliance statement for entities which implement the
            DLINKES-DHCP6-RELAY-MIB."
        MODULE -- this module
        MANDATORY-GROUPS {
            esDhcp6RBasicGroup
        }
        GROUP       esDhcp6RelayOption37Group
        DESCRIPTION
              "This group is required only if the agent supports relay agent
              Remote ID (option 37)."

        GROUP       esDhcp6RelayOption18Group
        DESCRIPTION
               "This group is required only if the agent supports relay agent
              Interface ID (option 18)."

        GROUP       esDhcp6RVlanCfgGroup
        DESCRIPTION
            "This group is required only for implementations that support
            DHCPv6 Local Relay for per VLAN."

        GROUP       esDhcp6RPortIfCfgGroup
        DESCRIPTION
            "This group is required only for implementations that support
            DHCPv6 relay configuration for per port."

        ::= { esDhcp6RelayCompliances 1 }

    esDhcp6RelayGroups OBJECT IDENTIFIER ::= { esDhcp6RelayMIBConformance 2 }

    esDhcp6RBasicGroup OBJECT-GROUP
        OBJECTS {
            esDhcp6RIfRelayDestRowStatus,
            esDhcp6ROptionExUdfMacFormatCase,
            esDhcp6ROptionExUdfMacFormatDelimiter,
            esDhcp6ROptionExUdfMacFormatDelimiterNumber
        }
        STATUS current
        DESCRIPTION
            "This group contains the collection of objects related to
            DHCPv6 relay configuration on an interface."
        ::= { esDhcp6RelayGroups 1 }


    esDhcp6RelayOption37Group OBJECT-GROUP
        OBJECTS {
            esDhcp6RRemoteIdInsertEnabled,
            esDhcp6RRemoteIdPolicy,
            esDhcp6RRemoteIdFormat,
            esDhcp6RRemoteIdUdfType,
            esDhcp6RRemoteIdUdfValue,
            esDhcp6ROption37ExUdfProfileValue,
            esDhcp6ROption37ExUdfProfileRowStatus
        }
        STATUS current
        DESCRIPTION
            "This group contains the collection of objects related to
            DHCPv6 relay agent Remote ID configuration."
        ::= { esDhcp6RelayGroups 2 }

    esDhcp6RelayOption18Group OBJECT-GROUP
        OBJECTS {
            esDhcp6RInterfaceIdInsertEnabled,
            esDhcp6RInterfaceIdPolicy,
            esDhcp6RInterfaceIdFormat,
            esDhcp6ROption18ExUdfProfileValue,
            esDhcp6ROption18ExUdfProfileRowStatus
