DLINKES-CABLE-DIAG-MIB DEFINITIONS ::= BEGIN

    IMPORTS
	    TEXTUAL-CONVENTION			FROM SNMPv2-TC
	    MODULE-IDENTITY,OBJECT-TYPE,
	    Integer32            		FROM SNMPv2-SMI
        MODULE-COMPLIANCE, OBJECT-GROUP
		                            FROM SNMPv2-CONF
	    ifIndex	        			FROM IF-MIB
	    dlinkCommon					FROM DLINK-ID-REC-MIB;

        		
	dlinkEsCableDiagMIB MODULE-IDENTITY
		LAST-UPDATED "201706050000Z"
        ORGANIZATION "D-Link Corp."
	  	CONTACT-INFO
            "	        D-Link Corporation

             	Postal: No. 289, Sinhu 3rd Rd., Neihu District,
                   		Taipei City 114, Taiwan, R.O.C
             	Tel:     +886-2-66000123
             	E-mail: tsd@dlink.com.tw
           	"
	  	DESCRIPTION
	    	"The MIB module for determining the status of 
			the cables attached to the device."
	
        REVISION "201706050000Z"
        DESCRIPTION
            " This is the first version of this MIB file.
            "
	  	::= {dlinkCommon 58}

    DlinkCableDiagStatus ::= TEXTUAL-CONVENTION
        STATUS         current
        DESCRIPTION
             "The status of a pair of the cable.
             other(0) - Other status is not specified here. E.g. the 
                        diagnostics has never been performed, or the previous
                        result is cleared.             
             ok(1)    - The pair or cable has no error.
             open(2)  - The cable in the error pair does not have a connection
                        at the specified position.
             short(3) - The cable in the error pair has a short problem at the
                        specified position.  
             openOrShort(4) - The PHY has no capability to distinguish between
                        open and short state.  
             crosstalk(5)- The cable in the error pair has a crosstalk problem
                        at the specified position.
             unKnown(6) - The diagnostics got an unknown status.                                                                                    
             noCable(7) - The port does not have any cable connection to the
                        remote partner.  
             shutdown(8)- The remote partner is powered off.             
            "
        SYNTAX         INTEGER {
            other(0),
            ok(1),
            open(2),
            short(3),
            openOrShort(4),
            crosstalk(5),
            unKnown(6),
            noCable(7),
            shutdown(8)                
        }
                                	
-- -----------------------------------------------------------------------------
    esCableDiagNotifications    OBJECT IDENTIFIER ::= { dlinkEsCableDiagMIB 0 }
    esCableDiagObjects          OBJECT IDENTIFIER ::= { dlinkEsCableDiagMIB 1 }
    esCableDiagConformance      OBJECT IDENTIFIER ::= { dlinkEsCableDiagMIB 2 }

-- -----------------------------------------------------------------------------
-- Notifications
-- -----------------------------------------------------------------------------

-- -----------------------------------------------------------------------------
-- Objects
-- -----------------------------------------------------------------------------	  		
    esCableDiagIfTable  OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsCableDiagIfEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table contains a list of information about test on the device's 	
            interfaces. Note that entries will exist in this table when the 
            corresponding interface is capable to run test."            
        ::= { esCableDiagObjects 1 }

    esCableDiagIfEntry OBJECT-TYPE
        SYNTAX          EsCableDiagIfEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "An entry in the esCableDiagIfTable, contains the
            testing controls on an interface."
        INDEX   { ifIndex }
        ::= { esCableDiagIfTable 1 }

    EsCableDiagIfEntry ::=   SEQUENCE {
		esCableDiagIfAction 	    INTEGER		
    }  
        
    esCableDiagIfAction OBJECT-TYPE 
        SYNTAX  INTEGER {
            noOp(1),
            test(2),
            clear(3)               
        }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "This object control the action to be executed on the interface.            
		            
            noOp(1)  - No action is taken if this object is set to 'noOp'.
                       When read, the value 'noOp' is returned.
                        
            test(2)  - Start the test on the interface.
	            	
            clear(3) - Clear all the test results on the interface. 
                       The value of the following objects of the entry will
                       become 'other'.
                       -- esCableDiagResultPair1Status
                       -- esCableDiagResultPair2Status
                       -- esCableDiagResultPair3Status  
                       -- esCableDiagResultPair4Status 
                       The value of the following objects of the entry will
                       become -1 (unavailable)
                       -- esCableDiagResultPair1Length
                       -- esCableDiagResultPair2Length
                       -- esCableDiagResultPair3Length
                       -- esCableDiagResultPair4Length
                       The value of esCableDiagResultStatus of the entry will
                       become 'notRun'.
            "            
        ::= { esCableDiagIfEntry 1 }           
        
-- -----------------------------------------------------------------------------                	  		
    esCableDiagResultTable  OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsCableDiagResultEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table contains a list of interface's cable situation.
            Note that entries will exist in this table when the 
            corresponding interface is a copper Ethernet port.
            "
        ::= { esCableDiagObjects 2 }

    esCableDiagResultEntry OBJECT-TYPE
        SYNTAX  EsCableDiagResultEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "An entry in esCableDiagResultTable contains cable situation
            of an interface."
        INDEX   { ifIndex }
        ::= { esCableDiagResultTable 1 }

    EsCableDiagResultEntry ::=       SEQUENCE {
		esCableDiagResultPair1Status 	DlinkCableDiagStatus,
		esCableDiagResultPair2Status    DlinkCableDiagStatus,
		esCableDiagResultPair3Status	DlinkCableDiagStatus,
		esCableDiagResultPair4Status	DlinkCableDiagStatus,
		esCableDiagResultPair1Length  	Integer32,
		esCableDiagResultPair2Length	Integer32,
		esCableDiagResultPair3Length	Integer32,
		esCableDiagResultPair4Length	Integer32,
		esCableDiagResultStatus			INTEGER
    }
       
    esCableDiagResultPair1Status OBJECT-TYPE
        SYNTAX          DlinkCableDiagStatus 
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the status of pair 1 of the cable."
        ::= { esCableDiagResultEntry 1 }
        
    esCableDiagResultPair2Status OBJECT-TYPE
        SYNTAX          DlinkCableDiagStatus
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the status of pair 2 of the cable."
        ::= { esCableDiagResultEntry 2 }        

    esCableDiagResultPair3Status OBJECT-TYPE
        SYNTAX          DlinkCableDiagStatus
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the status of pair 3 of the cable."
        ::= { esCableDiagResultEntry 3 }        

    esCableDiagResultPair4Status OBJECT-TYPE
        SYNTAX          DlinkCableDiagStatus
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the status of pair 4 of the cable."
        ::= { esCableDiagResultEntry 4 }
                           
    esCableDiagResultPair1Length OBJECT-TYPE
        SYNTAX          Integer32
        UNITS           "meters"        
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the approximate length or length to the failure of 
            pair 1 of the cable. This value is in meter units. 
            The special value of -1 indicates the length is unavailable."
        ::= { esCableDiagResultEntry 5 } 
        
    esCableDiagResultPair2Length OBJECT-TYPE
        SYNTAX          Integer32
        UNITS           "meters"
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "This object indicates the approximate length or length to the failure of 
            pair 2 of the cable. This value is in meter units.
            The special value of -1 indicates the length is unavailable."
        ::= { esCableDiagResultEntry 6 }  
        
    esCableDiagResultPair3Length OBJECT-TYPE
        SYNTAX          Integer32
        UNITS           "meters"
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the approximate length or length to the failure of 
            pair 3 of the cable. This value is in meter units.
            The special value of -1 indicates the length is unavailable."
        ::= { esCableDiagResultEntry 7 }   
        
    esCableDiagResultPair4Length OBJECT-TYPE
        SYNTAX          Integer32
        UNITS           "meters"
        MAX-ACCESS      read-only
        STATUS          current
        DESCRIPTION
            "This object indicates the approximate length or length to the failure of 
            pair 4 of the cable. This value is in meter units.
            The special value of -1 indicates the length is unavailable."
        ::= { esCableDiagResultEntry 8 }                         
        	        
    esCableDiagResultStatus OBJECT-TYPE 
        SYNTAX  INTEGER {
            notRun(0),
            processing(1),
            lastTestOk(2),
            lastTestFailed(3)
        }
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
            "Indicates the status of cable diagnostics on the interface.
            
            notRun(0) - the cable diagnostics has never been run for this
                        interface or the previous result is cleared.
            	
            processing(1) - the cable diagnostics is currently running on the
                          interface.
            	
            lastTestOk(2) - the last cable diagnostics was performed successfully
                          on the interface.
            	
            lastTestFailed(3) - the last cable diagnostics failed on the interface."
        ::= { esCableDiagResultEntry 9 } 
        
-- -----------------------------------------------------------------------------
-- Conformance
-- -----------------------------------------------------------------------------
    esCableDiagCompliances OBJECT IDENTIFIER ::= { esCableDiagConformance 1 }
		
	esCableDiagCompliance MODULE-COMPLIANCE
		STATUS          current
		DESCRIPTION 
			"The compliance statement for entities which implement the 
			DLINKES-CABLE-DIAG-MIB."
		MODULE -- this module
		MANDATORY-GROUPS { 
		    esCableDiagBasicGroup		    
		}					                        
	    ::= { esCableDiagCompliances 1 }
		
	esCableDiagGroups OBJECT IDENTIFIER ::= { esCableDiagCompliances 2 }
		
    esCableDiagBasicGroup OBJECT-GROUP
		OBJECTS { 
		    esCableDiagIfAction, 
		    esCableDiagResultPair1Status,
		    esCableDiagResultPair2Status,
		    esCableDiagResultPair3Status,
		    esCableDiagResultPair4Status,
		    esCableDiagResultPair1Length,
		    esCableDiagResultPair2Length,
		    esCableDiagResultPair3Length,
		    esCableDiagResultPair4Length,
		    esCableDiagResultStatus
		}
		STATUS current
		DESCRIPTION 
			"This group contains the collection of objects related to  
			 configuration and information of fundamental cable diagnostics feature."						
		::= { esCableDiagGroups 1 }

	

       
END

