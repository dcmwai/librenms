	esIpExtCompliances OBJECT IDENTIFIER ::= { esIpExtMIBConformance 1 }
		
	esIpExtCompliance MODULE-COMPLIANCE
		STATUS current
		DESCRIPTION 
			"The compliance statement for entities which implement the 
			DLINKES-IP-EXT-MIB."
		MODULE -- this module
		MANDATORY-GROUPS { 
		    esIpExtBasicGroup
		}	
		       
        GROUP       esIpExtBasicIpv6OnlyGroup 
        DESCRIPTION 
            "This group is required only if IPv6 is implemented by the agent."

        GROUP       esIpExtGeneralPrefixGroup 
        DESCRIPTION 
            "This group is required only if general prefix is implemented by
            the agent."

        OBJECT          esIpExtGeneralPrefix6to4IfIndex
	    MIN-ACCESS      read-only
	    DESCRIPTION
		    "Create/Write access is required only if the agent supports forming
            a general prefix for 6to4 tunnel."     

		GROUP       esIpExtGratuitousArpGroup 
        DESCRIPTION 
            "This group is required only if Gratuitous ARP feature is
            implemented by the agent."		
        
        GROUP       esIpExtProxyArpGroup 
        DESCRIPTION 
            "This group is required only if Proxy ARP feature is
            implemented by the agent."	
        
        OBJECT          esIpExtIfCfgLocalProxyArpEnabled
	    MIN-ACCESS      read-only
	    DESCRIPTION
		    "Create/Write access is required only if the agent supports local 
		    Proxy ARP."     
		
		GROUP       esIpExtDirectedBroadcastGroup 
        DESCRIPTION 
            "This group is required only if IP directed broadcast is
            implemented by the agent."	
        
        GROUP       esIpExtDhcpClientGroup 
        DESCRIPTION 
            "This group is required only if IP DHCP client is
            implemented by the agent."
         
        GROUP       esIpExtUdpForwardGroup 
        DESCRIPTION 
            "This group is required only if UDP forwarder is
            implemented by the agent." 

        GROUP       esIpExtIpv6AutoConfigGroup 
        DESCRIPTION 
            "This group is required only if SLAAC is
            implemented by the agent." 			
		::= { esIpExtCompliances 1 }
		
	esIpExtGroups OBJECT IDENTIFIER ::= { esIpExtMIBConformance 2 }
			
