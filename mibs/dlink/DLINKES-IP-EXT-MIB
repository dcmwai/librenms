-- ----------------------------------------------------------------------------- 
    esIpExtIpv6PrefixTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIpExtIpv6PrefixEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
	        "This table allows the creation and removal of IPv6
	        prefixes to be placed in Prefix Information
	        options in Router Advertisement messages sent
	        from the interface.    
            This is the enhancement of the ipAddressPrefixTable in IP-MIB.           
	        "
        ::= { esIpExtPrefixMgmt 2 }

    esIpExtIpv6PrefixEntry OBJECT-TYPE
        SYNTAX          EsIpExtIpv6PrefixEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
	        "An IPv6 interface prefix entry."
        INDEX  { 
            esIpExtIpv6PrefixIfIndex, 
            esIpExtIpv6Prefix,
            esIpExtIpv6PrefixLength 
        }
        ::= { esIpExtIpv6PrefixTable 1 }

    EsIpExtIpv6PrefixEntry ::= SEQUENCE {    
        esIpExtIpv6PrefixIfIndex             InterfaceIndex,
        esIpExtIpv6Prefix                    InetAddressIPv6,
        esIpExtIpv6PrefixLength              InetAddressPrefixLength,
        esIpExtIpv6PrefixValidLifetime       Unsigned32,
        esIpExtIpv6PrefixPreferLifetime      Unsigned32,
        esIpExtIpv6PrefixOnLinkFlag          TruthValue,    
        esIpExtIpv6PrefixAutonomousFlag      TruthValue,   
        esIpExtIpv6PrefixRowStatus           RowStatus
    }
    
    esIpExtIpv6PrefixIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
	        "The ifindex value which uniquely identifies the
            interface to which this entry is applicable. 
            " 
        ::= { esIpExtIpv6PrefixEntry 1 }
    
    esIpExtIpv6Prefix OBJECT-TYPE
        SYNTAX          InetAddressIPv6
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	        "The prefix of the entry."
        ::= { esIpExtIpv6PrefixEntry 2 }

    esIpExtIpv6PrefixLength OBJECT-TYPE
        SYNTAX          InetAddressPrefixLength
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	        "The prefix length of the entry."
        ::= { esIpExtIpv6PrefixEntry 3 }
 
    esIpExtIpv6PrefixValidLifetime OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	        "This object indicates the valid life time in seconds of the entry. 
            A value of 4,294,967,295 represents infinity.
            "
        DEFVAL { 2592000 }
        ::= { esIpExtIpv6PrefixEntry 4 }

    esIpExtIpv6PrefixPreferLifetime OBJECT-TYPE
        SYNTAX          Unsigned32
        UNITS           "seconds"
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	       "This object indicates the preferred life time in seconds of the entry.
            A value of 4,294,967,295 represents infinity.
           "
        DEFVAL { 604800 }
        ::= { esIpExtIpv6PrefixEntry 5 }

     esIpExtIpv6PrefixOnLinkFlag OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	       "This object has the value 'true(1)', if this prefix can be
            used for on-link determination; otherwise, the value is
            'false(2)'.

            The default for IPv4 prefixes is 'true(1)'."
        DEFVAL { false }
        ::= { esIpExtIpv6PrefixEntry 6 }

    esIpExtIpv6PrefixAutonomousFlag OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	       "Autonomous address configuration flag.  When true(1),
            indicates that this prefix can be used for autonomous
            address configuration (i.e., can be used to form a local
            interface address).  If false(2), it is not used to auto-
            configure a local interface address.

            The default for IPv4 prefixes is 'false(2)'."
        DEFVAL { true }
        ::= { esIpExtIpv6PrefixEntry 7 }

    esIpExtIpv6PrefixRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
	        "Used to control the addition and removal of IPv6
	        interface prefixes for RA messages."
        ::= { esIpExtIpv6PrefixEntry 99 }

-- ----------------------------------------------------------------------------- 
    esIpExtDhcpClientMgmt  OBJECT IDENTIFIER ::={ esIpExtMIBObjects 6 }
    
    esIpExtDhcpClientIfTable    OBJECT-TYPE    
        SYNTAX          SEQUENCE OF EsIpExtDhcpClientIfEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "A table contains a list of DHCP client configuration of interfaces."            
        ::= { esIpExtDhcpClientMgmt 1 }
        
    esIpExtDhcpClientIfEntry OBJECT-TYPE
        SYNTAX          EsIpExtDhcpClientIfEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION    
            "An entry is created to configure DHCP client per-interface
            settings to different value from default value. When an entry is
            deleted, all the settings are reverted to default value." 
        INDEX  { esIpExtDhcpClientIfIndex }
        ::= { esIpExtDhcpClientIfTable 1 }
                       
    EsIpExtDhcpClientIfEntry ::= SEQUENCE {
        esIpExtDhcpClientIfIndex             InterfaceIndex,  
        esIpExtDhcpClientIfClassIdType       INTEGER,
        esIpExtDhcpClientIfClassIdValue      DisplayString,            
        esIpExtDhcpClientIfClientIdIfIdx     InterfaceIndex,   
        esIpExtDhcpClientIfLeaseDay		    Integer32,
        esIpExtDhcpClientIfLeaseHour    	    Unsigned32,
        esIpExtDhcpClientIfLeaseMinute       Unsigned32,  
        esIpExtDhcpClientIfHostName          DisplayString
    }
    
    esIpExtDhcpClientIfIndex  OBJECT-TYPE
        SYNTAX          InterfaceIndex
	    MAX-ACCESS      not-accessible
	    STATUS          current	    
	    DESCRIPTION
	        "The ifIndex value of the interface.
            Only VLAN interfaces are valid interfaces."
        ::= { esIpExtDhcpClientIfEntry 1 }
        
	esIpExtDhcpClientIfClassIdType OBJECT-TYPE
        SYNTAX INTEGER      {
            ascii(1),
            hex(2)            
        }
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "The object indicates the type of class id which is defined by
            esIpExtDhcpClientIfClassIdValue.            
            The value means :
            ascii(1)- The esIpExtDhcpClientIfClassIdValue is ascii string.
            hex(2)  - The esIpExtDhcpClientIfClassIdValue is a string of HEX
                      number.
            "
        ::= { esIpExtDhcpClientIfEntry 2 }
        
    esIpExtDhcpClientIfClassIdValue  OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (0..64))
	    MAX-ACCESS      read-create
	    STATUS          current	    
	    DESCRIPTION
	        "This object indicates the value of vendor class identifier
	        (option 60) to be sent with the DHCP DISCOVER message. 
 
             An esIpExtDhcpClientIfClassIdValue value is always interpreted
             within the context of an esIpExtDhcpClientIfClassIdType value. 
             If esIpExtDhcpClientIfClassIdType is 'hex', this object is a HEX
             string value, which is restricted to hexadecimal character set."
        ::= { esIpExtDhcpClientIfEntry 3 }
                   
    esIpExtDhcpClientIfClientIdIfIdx  OBJECT-TYPE
        SYNTAX          InterfaceIndex
	    MAX-ACCESS      read-create
	    STATUS          current
	    DESCRIPTION	    
	        "This object indicates ifIndex of the VLAN interface whose
	        hexadecimal MAC address will be used as the client ID to be
	        sent with the DISCOVER message.
            "
        ::= { esIpExtDhcpClientIfEntry 4 }        
    
    esIpExtDhcpClientIfHostName  OBJECT-TYPE
        SYNTAX          DisplayString (SIZE (0..64))
	    MAX-ACCESS      read-create
	    STATUS          current	    
	    DESCRIPTION
	        "This object indicates the host name. The host name must start with
	        a letter, end with a letter or digit, and only with interior 
	        characters letters, digits, and hyphens.
	        "
        ::= { esIpExtDhcpClientIfEntry 5 }
               
    esIpExtDhcpClientIfLeaseDay OBJECT-TYPE
       SYNTAX           Integer32	(-1 | 0..10000)
       MAX-ACCESS       read-create
       STATUS           current
       DESCRIPTION
            "This object indicates the number of days for the duration of 
            preferred lease time. Value of -1 indicates that preferred lease
            time is unspecified. 
            This value is checked when an IP address is acquired from
            a DHCP server. "
       DEFVAL          { -1 }
       ::= { esIpExtDhcpClientIfEntry 6 }

    esIpExtDhcpClientIfLeaseHour OBJECT-TYPE
        SYNTAX          Unsigned32	(0..23)
        MAX-ACCESS      read-create
        STATUS      current
        DESCRIPTION
            "This object indicates the number of hours for the duration of preferred
            lease time."
        DEFVAL          { 0 }    
        ::= { esIpExtDhcpClientIfEntry 7 }

    esIpExtDhcpClientIfLeaseMinute OBJECT-TYPE
        SYNTAX          Unsigned32	(0..59)
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION
            "This object indicates the number of minutes for the duration of preferred
            lease time."
        DEFVAL          { 0 }     
        ::= { esIpExtDhcpClientIfEntry 8 } 
    
    esIpExtDhcpClientAutoconfig OBJECT-TYPE
        SYNTAX  INTEGER {
                    enabled(1),
                    disabled(2)
                }
        MAX-ACCESS  read-write
        STATUS  current
        DESCRIPTION
            "Indicates the status of automatically getting the configuration information
             from a TFTP server connected to the device."
        ::= { esIpExtDhcpClientMgmt 2 }

