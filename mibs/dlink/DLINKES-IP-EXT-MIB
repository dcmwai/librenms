		::= { esIpExtGroups 9 }
		
    esIpExtIpv6AutoConfigGroup OBJECT-GROUP
		OBJECTS { 
		    esIpExtIpv6AutoConfigEnabled, 
		    esIpExtIpv6AutoConfigDefault
        }
