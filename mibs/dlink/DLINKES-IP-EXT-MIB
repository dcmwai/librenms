-- -----------------------------------------------------------------------------           
    esIpExtUdpHelperAddrTable OBJECT-TYPE
        SYNTAX          SEQUENCE OF EsIpExtUdpHelperAddrEntry
        MAX-ACCESS      not-accessible
        STATUS          current          
        DESCRIPTION
            "This table consists of a list of target addresses for forwarding of
            UDP broadcast packets.
            "
        ::= { esIpExtUdpForwardMgmt 2 }

     esIpExtUdpHelperAddrEntry OBJECT-TYPE
        SYNTAX          EsIpExtUdpHelperAddrEntry
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION    
            "An target IP address for forwarding of the UDP broadcast packet
            on an interface.
            " 
        INDEX  { 
            esIpExtUdpHelperIfIndex,
            esIpExtUdpHelperAddrType,
            esIpExtUdpHelperAddr,
            esIpExtUdpHelperVrfState,
            esIpExtUdpHelperVrfName		
        }
        ::= { esIpExtUdpHelperAddrTable 1 }
                       
    EsIpExtUdpHelperAddrEntry ::= SEQUENCE {
        esIpExtUdpHelperIfIndex          InterfaceIndex,
        esIpExtUdpHelperAddrType         InetAddressType,		
        esIpExtUdpHelperAddr             InetAddress,
        esIpExtUdpHelperVrfState       	TruthValue,
        esIpExtUdpHelperVrfName        	DisplayString,		
        esIpExtUdpHelperAddrRowStatus    RowStatus
    }
    
    esIpExtUdpHelperIfIndex OBJECT-TYPE
        SYNTAX          InterfaceIndex
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The ifIndex value of the interface on which the entry is configured.
            Only VLAN interfaces are valid interfaces."
        ::= { esIpExtUdpHelperAddrEntry 1 }
 
    esIpExtUdpHelperAddrType OBJECT-TYPE
        SYNTAX          InetAddressType
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
           "The address type of UDP helper address."
        ::= { esIpExtUdpHelperAddrEntry 2 }

    esIpExtUdpHelperAddr  OBJECT-TYPE
        SYNTAX          InetAddress
	    MAX-ACCESS      not-accessible
	    STATUS          current	    
	    DESCRIPTION
	        "An IP address of the server.
            "
        ::= { esIpExtUdpHelperAddrEntry 3 }
		
    esIpExtUdpHelperVrfState OBJECT-TYPE
        SYNTAX          TruthValue
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION
             "This object indicates whether the virtual routing and forwarding (VRF) is configured.
             If the state is false, the helper address is assumed to be in the same address 
             space as the interface VRF, otherwise, the target address is in a different VRF, 
             or in the global address space."              
        DEFVAL          { false } 
        ::= { esIpExtUdpHelperAddrEntry 4 }
  
    esIpExtUdpHelperVrfName OBJECT-TYPE
        SYNTAX          DisplayString  (SIZE(0..32))
        MAX-ACCESS      not-accessible
        STATUS          current
        DESCRIPTION
            "The name of virtual routing and forwarding (VRF).  
            If this object is a zero length string, the helper address is in
            global routing and forwarding space."
        ::= { esIpExtUdpHelperAddrEntry 5 }		
        
	esIpExtUdpHelperAddrRowStatus OBJECT-TYPE
        SYNTAX          RowStatus
        MAX-ACCESS      read-create
        STATUS          current
        DESCRIPTION            
            "The status of this conceptual row." 
        ::= { esIpExtUdpHelperAddrEntry 99 }

