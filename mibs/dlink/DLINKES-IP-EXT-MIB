		STATUS current
		DESCRIPTION 
			"This group contains the collection of objects related to IP
			directed broadcasts feature."
		::= { esIpExtGroups 7 }
					
	esIpExtDhcpClientGroup OBJECT-GROUP
		OBJECTS { 
		    esIpExtDhcpClientIfClassIdType, 
		    esIpExtDhcpClientIfClassIdValue, 
		    esIpExtDhcpClientIfClientIdIfIdx, 
		    esIpExtDhcpClientIfHostName, 
			esIpExtDhcpClientIfLeaseDay, 
			esIpExtDhcpClientIfLeaseHour, 
			esIpExtDhcpClientIfLeaseMinute }
		STATUS current
		DESCRIPTION 
			"This group contains the collection of objects related to DHCP
